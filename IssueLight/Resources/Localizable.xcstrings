    "Nicht mehr verwendete CA-Zertifikate konnten nicht aus dem Schlüsselbund entfernt werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن إزالة شهادات CA التي لم تعد قيد الاستخدام من سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "CA শংসাপত্রগুলি যেগুলি আর ব্যবহারে নেই কীচেন থেকে সরানো যাবে না৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Unused CA certificates could not be removed from the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Los certificados de CA que ya no están en uso no se pudieron eliminar del llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Les certificats CA qui ne sont plus utilisés n'ont pas pu être supprimés du trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya cire takardun shaida na CA da ba a amfani da su daga ma'ajiyar maɓalli ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "जो CA प्रमाणपत्र अब उपयोग में नहीं हैं उन्हें किचेन से नहीं हटाया जा सकता।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat CA yang tidak lagi digunakan tidak dapat dihapus dari gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "使用されなくなった CA 証明書をキーチェーンから削除できませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "वापरात नसलेली CA-सर्टिफिकेट्स कीचेनमधून हटवता आली नाहीत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Unused CA certificates could not be removed from the keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Os certificados CA que não estão mais em uso não puderam ser removidos das chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификаты CA, которые больше не используются, не могут быть удалены из связки ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Inte längre använda CA-certifikat kunde inte tas bort från nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Vyeti vya CA visivyotumika haviwezi kuondolewa kwenye mkoba wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ప్రయోగిస్తున్నది కాని CA సర్టిఫికెట్లు కీచైన్ నుండి తొలగించలేకపోయాయి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kullanılmayan CA sertifikaları anahtar zincirinden kaldırılamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "CA سرٹیفیکیٹس جو اب استعمال میں نہیں ہیں انہیں کیچین سے ہٹایا نہیں جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể xóa các chứng chỉ CA không còn sử dụng khỏi chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法从钥匙串中删除不再使用的 CA 证书。"
          }
        }
      }
    },
    "Noch kein erfolgreicher Statusabruf": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لم يتم استرداد الحالة بنجاح حتى الآن"
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "এখনও কোন সফল স্থিতি পুনরুদ্ধার"
