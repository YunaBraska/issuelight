        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chứng chỉ CA được chọn không còn có sẵn trong chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "选定的 CA 证书在钥匙串中不再可用。"
          }
        }
      }
    },
    "Das ausgewählte Client-Zertifikat ist nicht mehr im Schlüsselbund verfügbar.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لم تعد شهادة العميل المحددة متوفرة في سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "নির্বাচিত ক্লায়েন্ট শংসাপত্র কীচেইনে আর উপলব্ধ নেই৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The selected client certificate is no longer available in the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El certificado de cliente seleccionado ya no está disponible en el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat client sélectionné n'est plus disponible dans le trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Takardar shaidar Abokin Ciniki da aka zaɓa ba ta nan a cikin maɓallin."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "चयनित क्लाइंट प्रमाणपत्र अब किचेन में उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat klien yang dipilih tidak lagi tersedia di rantai kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "選択したクライアント証明書はキーチェーンで使用できなくなりました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "निवडलेले क्लायंट प्रमाणपत्र आता किल्लीपट्टीत उपलब्ध नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Selected client certificate not available in keychain anymore."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado de cliente selecionado não está mais disponível nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Выбранный сертификат клиента больше не доступен в связке ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Det valda klientcertifikatet är inte längre tillgängligt i nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Cheti cha mteja kilichochaguliwa hakipo tena kwenye mkoba wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఎంచుకున్న క్లయింట్ సర్టిఫికేట్ కీచెయిన్‌లో ఇక అందుబాటులో లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Seçilen istemci sertifikası artık anahtar zincirinde mevcut değil."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "منتخب کردہ کلائنٹ سرٹیفکیٹ اب کیچین میں دستیاب نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chứng chỉ client được chọn không còn có sẵn trong chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "选定的客户端证书在钥匙串中不再可用。"
          }
        }
      }
    },
    "Das gespeicherte Passwort konnte nicht aus dem Schlüsselbund gelesen werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن قراءة كلمة المرور المحفوظة من سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "সংরক্ষিত পাসওয়ার্ড কীচেন থেকে পড়া যায়নি।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The saved password could not be read from the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La contraseña guardada no se pudo leer desde el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le mot de passe enregistré n'a pas pu être lu à partir du trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya karanta kalmar sirri da aka ajiye daga maɓallin ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सहेजा गया पासवर्ड किचेन से पढ़ा नहीं जा सका."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Kata sandi yang disimpan tidak dapat dibaca dari gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "保存されたパスワードをキーチェーンから読み取ることができませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "संग्रहित पासवर्ड किल्लीपट्टीतून वाचता आला नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Stored password can't read from keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A senha salva não pôde ser lida nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сохраненный пароль не удалось прочитать из связки ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Det sparade lösenordet kunde inte läsas från nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Nenosiri lililohifadhiwa haliwezi kusomwa kutoka kwenye mkoba wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "నిల్వ చేయబడిన పాస్వర్డ్ కీచెయిన్ నుంచి చదవలేకపోయింది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kaydedilmiş şifre anahtar zincirinden okunamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "محفوظ کردہ پاس ورڈ کیچین سے پڑھا نہیں جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể đọc mật khẩu đã lưu từ chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法从钥匙串中读取保存的密码。"
          }
        }
      }
    },
    "Der Benutzername darf keinen Doppelpunkt enthalten.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن أن يحتوي اسم المستخدم على نقطتين."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "ব্যবহারকারীর নামে একটি কোলন থাকতে পারে না।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The username must not contain a colon."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El nombre de usuario no puede contener dos puntos."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le nom d'utilisateur ne peut pas contenir de deux-points."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Sunan mai amfani bai kamata ya ƙunshi alamar ma'auni ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "उपयोगकर्ता नाम में कोलन नहीं हो सकता."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Nama pengguna tidak boleh mengandung titik dua."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "ユーザー名にはコロンを含めることはできません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "वापरकर्तानावात वक्ररेषा (:) असू नये."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Username must not contain colon."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O nome de usuário não pode conter dois pontos."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Имя пользователя не может содержать двоеточие."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Användarnamnet får inte innehålla kolon."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Jina la mtumiaji haliruhusiwi kuwa na alama ya nukta mbili."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "వినియోగదారు పేరు కొలన్ (:) కలిగి ఉండకూడదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kullanıcı adı iki nokta üst üste içermemelidir."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "صارف نام میں بڑی آنت نہیں ہو سکتی۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Tên người dùng không được chứa dấu hai chấm."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "用户名不能包含冒号。"
          }
        }
      }
    },
    "Der SHA-256-Fingerprint wurde übernommen. Prüfe die Verbindung, bevor du die Quelle speicherst.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تم اعتماد البصمة SHA-256 . تحقق من الاتصال قبل حفظ المصدر."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 ফিঙ্গারপ্রিন্ট গৃহীত হয়েছে। উৎস সংরক্ষণ করার আগে সংযোগ পরীক্ষা করুন."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The SHA-256 fingerprint has been adopted. Check the connection before saving the source."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Se ha adoptado la huella digital SHA-256. Verifique la conexión antes de guardar la fuente."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "L'empreinte digitale SHA-256 a été adoptée. Vérifiez la connexion avant de sauvegarder la source."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "An ɗauki fingerprint ɗin SHA-256. Duba haɗin kafin a ajiye tushen."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 फ़िंगरप्रिंट को अपनाया गया है. स्रोत को सहेजने से पहले कनेक्शन की जाँच करें."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sidik jari SHA-256 telah diadopsi. Periksa koneksi sebelum menyimpan sumbernya."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 の指紋が採用されています。ソースを保存する前に接続を確認してください。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256-फिंगरप्रिंट स्वीकारले गेले. स्रोत जतन करण्यापूर्वी कनेक्शन तपासा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "The SHA-256 fingerprint has been taken. Check connection before saving source."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A impressão digital SHA-256 foi adotada. Verifique a conexão antes de salvar a fonte."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Отпечаток пальца SHA-256 принят. Проверьте соединение перед сохранением источника."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256-fingeravtrycket har tagits över. Kontrollera anslutningen innan du sparar källan."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Alama ya vidole SHA-256 imetumika. Kagua muunganisho kabla ya kuhifadhi chanzo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256-ఫింగర్ప్రింట్ übernommen జరిగింది. మాడత సేవా ముందు కనెక్షన్‌ని తనిఖీ చెయండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 parmak izi alındı. Kaynağı kaydetmeden önce bağlantıyı kontrol et."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 فنگر پرنٹ کو اپنایا گیا ہے۔ ماخذ کو محفوظ کرنے سے پہلے کنکشن چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Dấu vân tay SHA-256 đã được chấp nhận. Kiểm tra kết nối trước khi lưu nguồn."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256指纹已被采用。保存源之前检查连接。"
          }
        }
      }
    },
    "Der Server antwortet, liefert aber keine kompatible Monitoring-Antwort.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "يستجيب الخادم ولكنه لا يوفر استجابة مراقبة متوافقة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "সার্ভার সাড়া দেয় কিন্তু একটি সামঞ্জস্যপূর্ণ পর্যবেক্ষণ প্রতিক্রিয়া প্রদান করে না।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The server responds but does not provide a compatible monitoring response."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El servidor responde pero no proporciona una respuesta de monitoreo compatible."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le serveur répond mais ne fournit pas de réponse de surveillance compatible."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Uwar garken tana amsawa, amma ba ta bayar da amsar sa ido mai dacewa ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सर्वर प्रतिक्रिया देता है लेकिन संगत निगरानी प्रतिक्रिया प्रदान नहीं करता है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Server merespons tetapi tidak memberikan respons pemantauan yang kompatibel."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "サーバーは応答しますが、互換性のある監視応答を提供しません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "सर्व्हर प्रतिसाद देतो, परंतु सुसंगत निरीक्षण प्रतिसाद प्रदान करत नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Server responds but does not provide compatible monitoring response."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O servidor responde, mas não fornece uma resposta de monitoramento compatível."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сервер отвечает, но не предоставляет совместимого ответа мониторинга."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Servern svarar, men levererar inget kompatibelt övervakningssvar."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Seva inajibu, lakini haipati majibu yanayofaa ya ufuatiliaji."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "సర్వర్ ప్రతిస్పందిస్తోంది, కానీ సూటిగా అనుకూలమైన మానిటరింగ్ ప్రతిస్పందన ఇవ్వడం లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Sunucu yanıt veriyor, ancak uyumlu bir izleme yanıtı sağlamıyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سرور جواب دیتا ہے لیکن ہم آہنگ نگرانی کا جواب فراہم نہیں کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Máy chủ phản hồi nhưng không cung cấp câu trả lời giám sát tương thích."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "服务器响应但不提供兼容的监控响应。"
          }
        }
      }
    },
    "Der Server antwortete mit HTTP %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "استجاب الخادم بـ HTTP %lld."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "সার্ভারটি HTTP %lld দিয়ে সাড়া দিয়েছে।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The server responded with HTTP %lld."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El servidor respondió con HTTP %lld."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le serveur a répondu avec HTTP %lld."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Uwar garken ta amsa da HTTP %lld."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सर्वर ने HTTP %lld से जवाब दिया।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Server merespons dengan HTTP %lld."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "サーバーは HTTP %lld で応答しました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "सर्व्हरने HTTP %lld ने उत्तर दिले."
          }
        },
        "pcm": {
