    "Die Anmeldung funktioniert, aber Rechte für Hosts oder Services fehlen.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "يعمل تسجيل الدخول، لكن حقوق المضيفين أو الخدمات مفقودة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "লগইন কাজ করে, কিন্তু হোস্ট বা পরিষেবার অধিকার অনুপস্থিত।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The login works, but rights for hosts or services are missing."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El inicio de sesión funciona, pero faltan derechos para hosts o servicios."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La connexion fonctionne, mais les droits pour les hôtes ou les services sont manquants."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Rajista tana aiki, amma haƙƙoƙi ga Masu masauki ko Ayyuka ba su nan."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "लॉगिन काम करता है, लेकिन होस्ट या सेवाओं के अधिकार गायब हैं।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Login berfungsi, tetapi hak untuk host atau layanan tidak ada."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "ログインは機能しますが、ホストまたはサービスに対する権限がありません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "नोंदणी कार्य करते, परंतु होस्ट किंवा सेवांसाठी अधिकार गायब आहेत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Login works, but no rights for hosts or services."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O login funciona, mas faltam direitos para hosts ou serviços."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Вход работает, но права на хосты или сервисы отсутствуют."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Inloggningen fungerar, men rättigheter för värdar eller tjänster saknas."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Uandishi wa jina unafaaa, lakini haki kwa Wenyeji au Huduma hazipo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "لاگిన్ పని చేస్తోంది, కానీ హోస్ట్‌లు లేదా సర్వీసుల కోసం అనుమతులు లేవు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kayıt yapılabiliyor, ancak ana bilgisayarlar veya servisler için izinler eksik."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "لاگ ان کام کرتا ہے، لیکن میزبانوں یا خدمات کے حقوق غائب ہیں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Đăng nhập hoạt động, nhưng quyền cho máy chủ hoặc dịch vụ còn thiếu."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "可以登录，但缺少主机或服务的权限。"
          }
        }
      }
    },
    "Die Anmeldung wurde abgelehnt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تم رفض التسجيل."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "নিবন্ধন প্রত্যাখ্যান করা হয়."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The login was rejected."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El registro fue rechazado."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "L'enregistrement a été rejeté."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "An ƙi rajista."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
