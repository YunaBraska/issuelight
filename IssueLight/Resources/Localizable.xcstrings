            "value": "%lld Vyanzo haviwezi kusasishwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "%lld మూలాలను నవీకరించలేకపోయింది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "%lld Kaynaklar güncellenemedi."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "%lld ذرائع کو اپ ڈیٹ نہیں کیا جا سکا۔"
