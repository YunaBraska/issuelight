    "Aktiviere mindestens eine Quelle, um den Status zu überwachen.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تمكين مصدر واحد على الأقل لمراقبة الحالة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "স্থিতি নিরীক্ষণ করতে কমপক্ষে একটি উত্স সক্ষম করুন৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Activate at least one source to monitor the status."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Habilite al menos una fuente para monitorear el estado."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Activez au moins une source pour surveiller l’état."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Kunna akalla wata hanya guda don sa ido kan matsayin."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "स्थिति की निगरानी के लिए कम से कम एक स्रोत सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Aktifkan setidaknya satu sumber untuk memantau status."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "少なくとも 1 つのソースを有効にしてステータスを監視します。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "किमान एक स्त्रोत सक्रिय करा, ताकि स्थितीचे निरीक्षण करता येईल."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Enable at least one source to monitor status."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Habilite pelo menos uma fonte para monitorar o status."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Включите хотя бы один источник для мониторинга состояния."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Aktivera minst en källa för att övervaka status."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Zimewekwa angalau chanzo kimoja ili kufuatilia hali."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "కనీసం ఒక మూలం యాక్టివేట్ చేయండి, స్థితిని పర్యవేక్షించడానికి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "En az bir kaynağı etkinleştirerek durumu izleyin."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "حالت کی نگرانی کے لیے کم از کم ایک ذریعہ کو فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Kích hoạt ít nhất một nguồn để theo dõi trạng thái."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "启用至少一个源来监视状态。"
          }
        }
      }
    },
