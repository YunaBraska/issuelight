    "Der ausgewählte Monitoring-Typ akzeptiert diese Serveradresse nicht.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "نوع المراقبة المحدد لا يقبل عنوان الخادم هذا."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "নির্বাচিত মনিটরিং টাইপ এই সার্ভার ঠিকানা গ্রহণ করে না।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The selected monitoring type does not accept this server address."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El tipo de monitoreo seleccionado no acepta esta dirección de servidor."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le type de surveillance sélectionné n'accepte pas cette adresse de serveur."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Nau'in lura da aka zaɓa baya karɓar wannan adireshin uwar garken."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "चयनित मॉनिटरिंग प्रकार इस सर्वर पते को स्वीकार नहीं करता है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Jenis pemantauan yang dipilih tidak menerima alamat server ini."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "選択した監視タイプは、このサーバー アドレスを受け入れません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "निवडलेला मॉनिटरिंग प्रकार हा सर्व्हर पत्ता स्वीकारत नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Selected monitoring type does not accept this server address."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O tipo de monitoramento selecionado não aceita este endereço de servidor."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Выбранный тип мониторинга не принимает этот адрес сервера."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Den valda övervakningstypen accepterar inte denna serveradress."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Aina ya uangalizi iliyochaguliwa hairuhusu anwani ya seva hii."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఎంచుకున్న మానిటరింగ్ రకం ఈ సెర్వర్ చిరునామాను తీసుకోదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Seçilen izleme türü bu sunucu adresini kabul etmiyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "منتخب کردہ نگرانی کی قسم اس سرور ایڈریس کو قبول نہیں کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Loại giám sát được chọn không chấp nhận địa chỉ máy chủ này."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "所选的监控类型不接受该服务器地址。"
          }
        }
      }
    },
