        "hi": {
          "stringUnit": { "state": "translated",
            "value": "पासवर्ड विशेष रूप से macOS किचेन में संग्रहीत है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Kata sandi disimpan secara eksklusif di gantungan kunci macOS."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "パスワードは macOS キーチェーンにのみ保存されます。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "पासवर्ड केवळ macOS-किल्लीपट्टीत संग्रहित केला जातो."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Password stored only in macOS keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A senha é armazenada exclusivamente no chaveiro macOS."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Пароль хранится исключительно в связке ключей macOS."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Lösenordet sparas enbart i nyckelringen macOS."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Nenosiri litawekwa tu kwenye mkoba wa funguo macOS."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "పాస్వర్డ్ macOS-కీచెయిన్‌లో మాత్రమే నిల్వ చేయబడుతుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Şifre yalnızca macOS anahtar zincirinde saklanır."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "پاس ورڈ کو خصوصی طور پر macOS کیچین میں محفوظ کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Mật khẩu chỉ được lưu trong chuỗi khóa macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "密码仅存储在 macOS 钥匙串中。"
          }
        }
      }
    },
    "Das Serverzertifikat konnte nicht gelesen werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن قراءة شهادة الخادم."
