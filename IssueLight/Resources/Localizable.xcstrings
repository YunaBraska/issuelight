    "Konfiguration eingeben, Verbindung prüfen und anschließend speichern.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "أدخل التكوين، وتحقق من الاتصال ثم احفظ."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "কনফিগারেশন লিখুন, সংযোগ পরীক্ষা করুন এবং তারপর সংরক্ষণ করুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Enter configuration, check connection, and then save."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Ingrese a la configuración, verifique la conexión y luego guarde."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Entrez la configuration, vérifiez la connexion puis enregistrez."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Shigar da saituna, duba haɗin kai sannan a adana."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "कॉन्फ़िगरेशन दर्ज करें, कनेक्शन जांचें और फिर सहेजें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Masuk ke konfigurasi, periksa koneksi lalu simpan."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "設定を入力し、接続を確認して保存します。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "कॉन्फिगरेशन प्रविष्ट करा, कनेक्शन तपासा आणि नंतर जतन करा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Enter configuration, check connection, then save."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Entre na configuração, verifique a conexão e salve."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Введите конфигурацию, проверьте соединение и сохраните."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Ange konfiguration, kontrollera anslutningen och spara sedan."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "\\nWeka usanidi, hakiki muunganiko kisha uhifadhi."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "కాన్ఫిగరేషన్‌ను నమోదు చేసి, కనెక్షన్‌ని తనిఖీ చేసి, ఆ తరువాత భద్రపరచండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Yapılandırmayı girin, bağlantıyı kontrol edin ve ardından kaydedin."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "کنفیگریشن درج کریں، کنکشن چیک کریں اور پھر محفوظ کریں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Nhập cấu hình, kiểm tra kết nối và sau đó lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "输入配置，检查连接，然后保存。"
          }
        }
      }
    },
