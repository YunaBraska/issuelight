    "Leer lassen, um das vorhandene Passwort bei unveränderten Zugangsdaten beizubehalten.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "اتركه فارغًا للاحتفاظ بكلمة المرور الحالية مع عدم تغيير بيانات الوصول."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "অপরিবর্তিত অ্যাক্সেস ডেটা সহ বিদ্যমান পাসওয়ার্ড রাখতে ফাঁকা রাখুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Leave blank to keep the existing password if access data has not changed."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Déjelo en blanco para mantener la contraseña existente sin modificar los datos de acceso."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Laissez vide pour conserver le mot de passe existant avec les données d'accès inchangées."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "A bar shi a fanko, don ci gaba da amfani da kalmar wucewa da ke akwai idan bayanan shiga ba su canza ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "मौजूदा पासवर्ड को अपरिवर्तित एक्सेस डेटा के साथ रखने के लिए खाली छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Biarkan kosong untuk menjaga kata sandi yang ada dengan data akses tidak berubah."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "アクセス データを変更せずに既存のパスワードを保持するには、空白のままにします。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "बदल न केलेल्या प्रवेश तपशीलांसह विद्यमान पासवर्ड जतन ठेवण्यासाठी रिक्त ठेवा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Leave blank to keep existing password with unchanged access data."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Deixe em branco para manter a senha existente com os dados de acesso inalterados."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Оставьте пустым, чтобы сохранить существующий пароль с неизмененными данными доступа."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Lämna tomt för att behålla befintligt lösenord om inloggningsuppgifterna inte ändrats."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Acha tupu, ili kudumisha nenosiri lililopo ikiwa taarifa za ufikisho hazijabadilika."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "మార్పు చేయని ప్రామాణీకరణ వివరాలతో ఉన్న పాస్వర్డ్‌ను మెయింటైన్ చేయడానికి ఖాళీగా వదిలేయండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Mevcut şifreyi değiştirilmemiş erişim bilgilerinde korumak için boş bırakın."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "غیر تبدیل شدہ رسائی ڈیٹا کے ساتھ موجودہ پاس ورڈ رکھنے کے لیے خالی چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Để trống để giữ mật khẩu hiện tại nếu thông tin truy cập không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "留空可保留现有密码且访问数据不变。"
          }
        }
      }
    },
