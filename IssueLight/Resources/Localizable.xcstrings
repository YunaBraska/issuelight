          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Sunucu sertifikası okunamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سرور سرٹیفکیٹ پڑھا نہیں جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể đọc chứng chỉ máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法读取服务器证书。"
          }
        }
      }
    },
    "Das ausgewählte CA-Zertifikat ist nicht mehr im Schlüsselbund verfügbar.": {
      "localizations": {
        "ar": {
