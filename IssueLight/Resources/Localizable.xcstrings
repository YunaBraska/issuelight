    "Die sichere Verbindung ist fehlgeschlagen.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "فشل الاتصال الآمن."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "নিরাপদ সংযোগ ব্যর্থ হয়েছে."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The secure connection failed."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La conexión segura falló."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La connexion sécurisée a échoué."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Haɗin mai tsaro ya gaza."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सुरक्षित कनेक्शन विफल रहा."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Koneksi aman gagal."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "安全な接続に失敗しました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "सुरक्षित कनेक्शन अयशस्वी झाले."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Secure connection failed."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A conexão segura falhou."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Безопасное соединение не удалось."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Den säkra anslutningen misslyckades."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Muunganisho salama umefeli."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "భద్రమైన కనెక్షన్ విఫలమైంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Güvenli bağlantı başarısız oldu."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "محفوظ کنکشن ناکام ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Kết nối an toàn đã thất bại."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "安全连接失败。"
          }
        }
      }
    },
    "Die Änderungen an der aktuellen Quelle wurden noch nicht gespeichert.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لم يتم حفظ التغييرات التي تم إجراؤها على المصدر الحالي بعد."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "বর্তমান উত্সের পরিবর্তনগুলি এখনও সংরক্ষণ করা হয়নি৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The changes to the current source have not yet been saved."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Los cambios en la fuente actual aún no se han guardado."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Les modifications apportées à la source actuelle n'ont pas encore été enregistrées."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Bai ɗauki sauye-sauye akan tushen da ake ciki ba tukuna."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "वर्तमान स्रोत में परिवर्तन अभी तक सहेजे नहीं गए हैं।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Perubahan pada sumber saat ini belum disimpan."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "現在のソースへの変更はまだ保存されていません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "चालू स्त्रोतावरील बदल अजून जतन केलेले नाहीत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Changes to the current source have not been saved yet."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "As alterações na fonte atual ainda não foram salvas."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Изменения текущего источника еще не сохранены."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Ändringarna i den aktuella källan har ännu inte sparats."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Mabadiliko kwenye chanzo kilicho sasa bado hayijahifadhiwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ప్రస్తుత సోర్స్‌లో మార్పులు ఇంకా సేన్ చేయబడలేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Mevcut kaynaktaki değişiklikler henüz kaydedilmedi."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "موجودہ ماخذ میں تبدیلیاں ابھی تک محفوظ نہیں ہوئی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Các thay đổi đối với nguồn hiện tại chưa được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "对当前源的更改尚未保存。"
          }
        }
      }
    },
    "Diese Authentifizierung wird vom ausgewählten Monitoring-Typ nicht unterstützt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "هذه المصادقة غير مدعومة بنوع المراقبة المحدد."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "এই প্রমাণীকরণটি নির্বাচিত মনিটরিং টাইপ দ্বারা সমর্থিত নয়৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "This authentication is not supported by the selected monitoring type."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Esta autenticación no es compatible con el tipo de supervisión seleccionado."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Cette authentification n'est pas prise en charge par le type de surveillance sélectionné."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Wannan tabbatarwa ba a tallafawa ta nau'in sa ido da aka zaɓa ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "यह प्रमाणीकरण चयनित निगरानी प्रकार द्वारा समर्थित नहीं है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Otentikasi ini tidak didukung oleh jenis pemantauan yang dipilih."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "この認証は、選択した監視タイプではサポートされていません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "हा प्रमाणीकरण निवडलेल्या मॉनिटरिंग प्रकाराद्वारे समर्थित नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "This authentication is not supported by the selected monitoring type."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Esta autenticação não é suportada pelo tipo de monitoramento selecionado."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Эта аутентификация не поддерживается выбранным типом мониторинга."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Denna autentisering stöds inte av den valda övervakningstypen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Uthibitishaji huu hauungwi mkono na aina ya ufuatiliaji uliyochaguliwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఈ ధృవీకరణని ఎంచుకున్న మానిటరింగ్ రకం మద్దతు ఇవ్వడం లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Bu kimlik doğrulama seçilen izleme türü tarafından desteklenmiyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "یہ توثیق منتخب نگرانی کی قسم کے ذریعے تعاون یافتہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Xác thực này không được loại giám sát đã chọn hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "所选监控类型不支持此身份验证。"
          }
        }
      }
    },
    "Diese Zertifikatsoption wird noch nicht unterstützt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "خيار الشهادة هذا غير مدعوم بعد."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "এই শংসাপত্র বিকল্পটি এখনও সমর্থিত নয়৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "This certificate option is not yet supported."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Esta opción de certificado aún no es compatible."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Cette option de certificat n'est pas encore prise en charge."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Wannan zaɓin takaddun shaida ba a tallafawa shi ba tukuna."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "यह प्रमाणपत्र विकल्प अभी तक समर्थित नहीं है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Opsi sertifikat ini belum didukung."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "この証明書オプションはまだサポートされていません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "हा प्रमाणपत्र पर्याय अद्याप समर्थित नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "This certificate option is not yet supported."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Esta opção de certificado ainda não é suportada."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Этот вариант сертификата пока не поддерживается."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Detta certifikatalternativ stöds ännu inte."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Chaguo hili la cheti bado halina msaada."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఈ సర్టిఫికెట్ ఎంపికకి ఇంకా మద్దతు ఇవ్వబడలేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Bu sertifika seçeneği henüz desteklenmiyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سرٹیفکیٹ کا یہ اختیار ابھی تک تعاون یافتہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Tùy chọn chứng chỉ này chưa được hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "尚不支持此证书选项。"
          }
        }
      }
    },
    "Diese Zertifikatsoption wird von dieser Version noch nicht unterstützt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "خيار الشهادة هذا غير مدعوم حتى الآن في هذا الإصدار."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "এই শংসাপত্র বিকল্পটি এখনও এই সংস্করণে সমর্থিত নয়৷"
          }
