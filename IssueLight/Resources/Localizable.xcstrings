    "Client-Zertifikate konnten nicht aus dem Schlüsselbund gelesen werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن قراءة شهادات العميل من سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "কীচেন থেকে ক্লায়েন্ট সার্টিফিকেট পড়া যাবে না।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Client certificates could not be read from the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "No se pudieron leer los certificados de cliente desde el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Les certificats clients n'ont pas pu être lus à partir du trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya karanta takardun shedar abokin ciniki daga ma'ajiyar maɓalli ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "क्लाइंट प्रमाणपत्र कीचेन से पढ़ा नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat klien tidak dapat dibaca dari gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "クライアント証明書をキーチェーンから読み取ることができませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "क्लायंट प्रमाणपत्रे कीचेनमधून वाचली जाऊ शकली नाहीत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Client certificate can't read from keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Os certificados do cliente não puderam ser lidos nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификаты клиента не удалось прочитать из связки ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Klientcertifikat kunde inte läsas från nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Hatuwezi kusoma vyeti vya mteja kutoka kwenye mfuko wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "కీలుబంధం నుండి క్లయింట్ సర్టిఫికెట్స్ ను చదవలేము."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Anahtar zincirinden istemci sertifikaları okunamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "کیچین سے کلائنٹ کے سرٹیفکیٹس کو پڑھا نہیں جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể đọc chứng chỉ khách hàng từ chìa khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法从钥匙串中读取客户端证书。"
          }
        }
      }
    },
    "Das CA-Zertifikat ist nicht mehr im Schlüsselbund verfügbar.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لم تعد شهادة CA متاحة في سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "CA শংসাপত্র কীচেইনে আর উপলব্ধ নেই৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The CA certificate is no longer available in the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El certificado de CA ya no está disponible en el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat CA n'est plus disponible dans le trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a sami takardar shedar CA a ciki ma'ajiyar maɓalli ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "CA प्रमाणपत्र अब किचेन में उपलब्ध नहीं है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat CA tidak lagi tersedia di gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "CA 証明書はキーチェーンで使用できなくなりました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "CA-प्रमाणपत्र कीचेनमध्ये अधिक उपलब्ध नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "CA certificate not available in keychain anymore."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado CA não está mais disponível nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат CA больше не доступен в связке ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "CA-certifikatet är inte längre tillgängligt i nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Cheti cha CA hakipo tena kwenye mfuko wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "CA-సర్టిఫికెట్ ఇప్పుడు కీలుబంధంలో అందుబాటులో లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "CA sertifikası anahtar zincirinde artık mevcut değil."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "CA سرٹیفکیٹ اب کیچین میں دستیاب نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chứng chỉ CA không còn có sẵn trong chìa khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "CA 证书在钥匙串中不再可用。"
          }
        }
      }
    },
