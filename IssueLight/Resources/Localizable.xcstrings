    "Bei einer Zertifikatserneuerung bleibt die Verbindung blockiert, bis du das neue Zertifikat hier geprüft und ausgewählt hast.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "عند تجديد الشهادة، يظل الاتصال محظورًا حتى تقوم بالتحقق من الشهادة الجديدة وتحديدها هنا."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "যখন একটি শংসাপত্র পুনর্নবীকরণ করা হয়, আপনি এখানে নতুন শংসাপত্রটি চেক এবং নির্বাচন না করা পর্যন্ত সংযোগটি অবরুদ্ধ থাকে৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "During a certificate renewal, the connection remains blocked until you have checked and selected the new certificate here."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Cuando se renueva un certificado, la conexión permanece bloqueada hasta que hayas verificado y seleccionado el nuevo certificado aquí."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Lorsqu'un certificat est renouvelé, la connexion reste bloquée jusqu'à ce que vous ayez vérifié et sélectionné ici le nouveau certificat."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "A lokacin sabunta takardar shaida, haɗin yana ci gaba da kasancewa a toshe har sai ka duba sabon takardar shaida a nan ka zaba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "जब किसी प्रमाणपत्र का नवीनीकरण किया जाता है, तो कनेक्शन तब तक अवरुद्ध रहता है जब तक कि आप यहां नए प्रमाणपत्र की जांच और चयन नहीं कर लेते।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Ketika sertifikat diperpanjang, koneksi tetap diblokir sampai Anda memeriksa dan memilih sertifikat baru di sini."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "証明書が更新されると、ここで新しい証明書を確認して選択するまで、接続はブロックされたままになります。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "प्रमाणपत्र नूतनीकरण करताना, नवीन प्रमाणपत्र येथे तपासले आणि निवडले जात नसल्यास कनेक्शन ब्लॉक राहते."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "During certificate renewal, connection is blocked until you check and select the new certificate here."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Quando um certificado é renovado, a conexão permanece bloqueada até que você verifique e selecione o novo certificado aqui."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "При обновлении сертификата соединение остается заблокированным до тех пор, пока вы не проверите и не выберете здесь новый сертификат."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Vid ett certifikatförnyelseblockeras anslutningen tills du har kontrollerat och valt det nya certifikatet här."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Wakati wa upya wa cheti, muunganiko unabaki kufungwa hadi uchaguwe na kuthibitishwa hapa cheti kipya."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "సర్టిఫికేట్ పునరుద్ధరణ సమయంలో, మీరు కొత్త సర్టిఫికేట్‌ను ఇక్కడ తనిఖీ చేసి ఎంచేవరకు కనెక్షన్ బ్లాక్ అవుతుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Bir sertifika yenilemesinde, bağlantı burada yeni sertifikayı kontrol edip seçene kadar engellenmiş kalır."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "جب کسی سرٹیفکیٹ کی تجدید کی جاتی ہے، تو کنکشن اس وقت تک مسدود رہتا ہے جب تک کہ آپ یہاں نئے سرٹیفکیٹ کو چیک اور منتخب نہ کر لیں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Khi gia hạn chứng chỉ, kết nối vẫn bị chặn cho đến khi bạn kiểm tra và chọn chứng chỉ mới ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "续订证书后，连接将保持阻止状态，直到您在此处检查并选择新证书为止。"
          }
        }
      }
    },
