          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "आयात संकेतशब्द संग्रहित केला जात नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Import password not saved."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A senha de importação não é salva."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Пароль импорта не сохраняется."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Importlösenordet sparas inte."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Nenosiri la kuingiza halihifadhiwi."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "దిగుమతి పాస్వర్డ్ సేవ్ చేయబడదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "İçe aktarma şifresi kaydedilmiyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "درآمدی پاس ورڈ محفوظ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Mật khẩu nhập khẩu không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "不保存导入密码。"
          }
        }
      }
    },
    "Das PKCS#12-Zertifikat konnte nicht importiert werden. Datei oder Passwort ist ungültig.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن استيراد شهادة PKCS#12. الملف أو كلمة المرور غير صالحة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 শংসাপত্রটি আমদানি করা যায়নি৷ ফাইল বা পাসওয়ার্ড অবৈধ।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The PKCS#12 certificate could not be imported. File or password is invalid."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "No se pudo importar el certificado PKCS#12. El archivo o la contraseña no son válidos."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat PKCS#12 n'a pas pu être importé. Le fichier ou le mot de passe n'est pas valide."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya shigo da takardar shaidar PKCS#12 ba. Fayil ko kalmar wucewa ba ta da kyau."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 प्रमाणपत्र आयात नहीं किया जा सका. फ़ाइल या पासवर्ड अमान्य है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat PKCS#12 tidak dapat diimpor. File atau kata sandi tidak valid."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 証明書をインポートできませんでした。ファイルまたはパスワードが無効です。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 प्रमाणपत्र आयात करता आले नाही. फाईल किंवा संकेतशब्द अवैध आहे."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "The PKCS#12 certificate can't import. File or password is invalid."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado PKCS#12 não pôde ser importado. O arquivo ou a senha são inválidos."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат PKCS#12 не удалось импортировать. Файл или пароль недействительны."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12-certifikatet kunde inte importeras. Fil eller lösenord är ogiltigt."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Shaha ya PKCS#12 haiwezi kuingizwa. Faili au nenosiri si sahihi."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 సర్టిఫికేట్ ను దిగుమతి చేయలేకపోయాం. ఫైలు లేదా పాస్వర్డ్ తప్పు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 sertifikası içe aktarılamadı. Dosya veya şifre geçersiz."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "PKCS#12 سرٹیفکیٹ درآمد نہیں کیا جا سکا۔ فائل یا پاس ورڈ غلط ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể nhập chứng chỉ PKCS#12. Tệp hoặc mật khẩu không hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法导入 PKCS#12 证书。文件或密码无效。"
          }
        }
      }
    },
    "Das Passwort ist nicht mehr im Schlüsselbund verfügbar.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "كلمة المرور لم تعد متوفرة في سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "পাসওয়ার্ডটি কীচেইনে আর উপলব্ধ নেই।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The password is no longer available in the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La contraseña ya no está disponible en el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le mot de passe n'est plus disponible dans le trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Kalmar wucewa ba ta nan a cikin ma'ajin makullai ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "पासवर्ड अब किचेन में उपलब्ध नहीं है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Kata sandi tidak lagi tersedia di gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "パスワードはキーチェーンでは使用できなくなりました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "संकेतशब्द आता कीचेनमध्ये उपलब्ध नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Password not available in keychain anymore."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A senha não está mais disponível no chaveiro."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Пароль больше не доступен в связке ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Lösenordet är inte längre tillgängligt i nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Nenosiri halipatikani tena kwenye mkoba wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "పాస్వర్డ్ ఇక కీచైన్‌లో అందుబాటులో లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Şifre artık anahtar zincirinde mevcut değildir."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "کیچین میں پاس ورڈ اب دستیاب نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Mật khẩu không còn có sẵn trong chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "密码在钥匙串中不再可用。"
          }
        }
      }
    },
    "Das Passwort wird ausschließlich im macOS-Schlüsselbund gespeichert.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "يتم تخزين كلمة المرور حصريًا في سلسلة المفاتيح macOS."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "পাসওয়ার্ডটি একচেটিয়াভাবে macOS কীচেইনে সংরক্ষণ করা হয়।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The password is stored exclusively in the macOS keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La contraseña se almacena exclusivamente en el llavero macOS."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le mot de passe est stocké exclusivement dans le trousseau macOS."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Kalmar sirri za ta ajiye a cikin maɓallin macOS kawai."
          }
