    "Die Quelle wurde entfernt, aber nicht mehr verwendete Schlüsselbund-Einträge konnten nicht vollständig gelöscht werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تمت إزالة المصدر، ولكن تعذر حذف إدخالات سلسلة المفاتيح التي لم تعد مستخدمة بالكامل."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "উত্সটি সরানো হয়েছে, কিন্তু কীচেন এন্ট্রিগুলি যা আর ব্যবহার করা হয়নি তা সম্পূর্ণরূপে মুছে ফেলা যাবে না৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The source was removed, but unused keychain entries could not be completely deleted."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La fuente se eliminó, pero las entradas del llavero que ya no se usaban no se pudieron eliminar por completo."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La source a été supprimée, mais les entrées du trousseau qui n'étaient plus utilisées n'ont pas pu être complètement supprimées."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "An cire tushen, amma ba a iya share cikakke bayanan maɓallin da ba a amfani da su ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "स्रोत हटा दिया गया था, लेकिन किचेन प्रविष्टियाँ जिनका अब उपयोग नहीं किया गया था, उन्हें पूरी तरह से हटाया नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sumbernya telah dihapus, namun entri gantungan kunci yang tidak lagi digunakan tidak dapat dihapus sepenuhnya."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "ソースは削除されましたが、使用されなくなったキーチェーン エントリを完全に削除できませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "स्रोत काढला गेला, परंतु वापरात नसलेले कीबंड एंट्री पूर्णपणे काढता आले नाहीत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Source was removed, but unused keychain entries could not be fully deleted."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A fonte foi removida, mas as entradas das chaves que não eram mais usadas não puderam ser completamente excluídas."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Источник был удален, но записи связки ключей, которые больше не использовались, не удалось полностью удалить."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Källan togs bort, men oanvända nyckelringsposter kunde inte raderas helt."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Chanzo kimeondolewa, lakini rekodi za mkusanyiko wa maneno ya siri ambazo hazitumiki tena haziwezi kufutwa kabisa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "మూలాన్ని తొలగించబడింది, కానీ ఉపయోగంలో olmayan కీచైన్ ఎంట్రీలను పూర్తిగా తొలగించలేకపోయింది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kaynak kaldırıldı, ancak artık kullanılmayan anahtar zinciri girdileri tamamen silinemedi."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "ماخذ کو ہٹا دیا گیا تھا، لیکن کیچین کے اندراجات جو اب استعمال نہیں کیے گئے تھے، مکمل طور پر حذف نہیں کیے جا سکتے تھے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Nguồn đã bị xóa, nhưng các mục chuỗi khóa không còn sử dụng không thể xóa hoàn toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "源已删除，但不再使用的钥匙串条目无法完全删除。"
          }
        }
      }
    },
    "Die Quellenkonfiguration ist ungültig.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تكوين المصدر غير صالح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "উৎস কনফিগারেশন অবৈধ."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The source configuration is invalid."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La configuración de origen no es válida."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La configuration source n'est pas valide."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Saitin tushen ba daidai ba ne."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "स्रोत कॉन्फ़िगरेशन अमान्य है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Konfigurasi sumber tidak valid."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "ソース構成が無効です。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "स्रोत कॉन्फिगरेशन अवैध आहे."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Source configuration is invalid."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A configuração de origem é inválida."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Исходная конфигурация недействительна."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Källkonfigurationen är ogiltiga."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Mpangilio wa vyanzo si sahihi."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "సోర్స్ కాన్ఫిగరేషన్ చెల్లుబాటు కాదిది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kaynak yapılandırması geçersiz."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سورس کنفیگریشن غلط ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Cấu hình nguồn không hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "源配置无效。"
          }
        }
      }
    },
    "Die Quellenkonfiguration wird von diesem Mac entfernt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تمت إزالة التكوين المصدر من جهاز Mac هذا."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "এই ম্যাক থেকে উৎস কনফিগারেশন সরানো হয়েছে।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The source configuration is being removed from this Mac."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La configuración de origen se elimina de esta Mac."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La configuration source est supprimée de ce Mac."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Za a cire saitin tushen daga wannan Mac."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "इस मैक से स्रोत कॉन्फ़िगरेशन हटा दिया गया है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Konfigurasi sumber dihapus dari Mac ini."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "ソース構成はこの Mac から削除されます。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "स्रोत कॉन्फिगरेशन हा या मॅकवरून काढला जाईल."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Source configuration will be removed from this Mac."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A configuração de origem foi removida deste Mac."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Исходная конфигурация удалена с этого Mac."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Källkonfigurationen tas bort från denna Mac."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Mpangilio wa vyanzo utaondolewa kutoka kwenye Mac hii."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఈ మాక్ నుండి సోర్స్ కాన్ఫిగరేషన్ తొలగించబడుతుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kaynak yapılandırması bu Mac'ten kaldırılıyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "ماخذ کی ترتیب کو اس میک سے ہٹا دیا گیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Cấu hình nguồn sẽ bị xóa khỏi Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "源配置已从此 Mac 中删除。"
          }
        }
      }
    },
    "Die Serveradresse benötigt einen Hostnamen.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "يتطلب عنوان الخادم اسم مضيف."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "সার্ভার ঠিকানা একটি হোস্টনাম প্রয়োজন."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The server address requires a hostname."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La dirección del servidor requiere un nombre de host."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "L'adresse du serveur nécessite un nom d'hôte."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Adireshin uwar garken yana buƙatar sunan mai masauki."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सर्वर पते के लिए होस्टनाम की आवश्यकता होती है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Alamat server memerlukan nama host."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "サーバーアドレスにはホスト名が必要です。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "सर्व्हर पत्त्यास होस्टनेम आवश्यक आहे."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Server address needs a hostname."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O endereço do servidor requer um nome de host."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Для адреса сервера требуется имя хоста."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Serveradressen kräver ett värdnamn."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Anwani ya seva inahitaji jina la mwenyeji."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "సర్వర్ చిరునామాకు హోస్ట్ పేరు అవసరం."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Sunucu adresi bir ana bilgisayar adı gerektirir."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سرور ایڈریس کے لیے میزبان نام کی ضرورت ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Địa chỉ máy chủ yêu cầu tên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "服务器地址需要主机名。"
          }
        }
      }
    },
    "Die Serveradresse ist keine gültige URL.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "عنوان الخادم ليس عنوان URL صالحًا."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "সার্ভার ঠিকানা একটি বৈধ URL নয়."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The server address is not a valid URL."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La dirección del servidor no es una URL válida."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "L'adresse du serveur n'est pas une URL valide."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Adireshin uwar garken ba adireshin URL mai inganci bane."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सर्वर पता मान्य URL नहीं है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Alamat server bukan URL yang valid."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "サーバー アドレスは有効な URL ではありません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "सर्व्हर पत्ता वैध URL नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Server address is not a valid URL."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O endereço do servidor não é um URL válido."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Адрес сервера не является допустимым URL-адресом."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Serveradressen är inte en giltig URL."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Anwani ya seva si URL halali."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "సర్వర్ చిరునామా చెల్లుబాటు అయ్యే URL కాదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Sunucu adresi geçerli bir URL değil."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سرور کا پتہ درست URL نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Địa chỉ máy chủ không phải là một URL hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "服务器地址不是有效的 URL。"
          }
        }
      }
    },
    "Die TLS-Verbindung ist fehlgeschlagen. Prüfe Zertifikat und Servernamen.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "فشل الاتصال TLS. تحقق من الشهادة واسم الخادم."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "TLS সংযোগ ব্যর্থ হয়েছে৷ সার্টিফিকেট এবং সার্ভারের নাম চেক করুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The TLS connection failed. Check certificate and server name."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La conexión TLS falló. Verifique el certificado y el nombre del servidor."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La connexion TLS a échoué. Vérifiez le certificat et le nom du serveur."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Haɗin TLS ya gaza. Duba takaddun shaida da sunan uwar garken."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "TLS कनेक्शन विफल रहा. प्रमाणपत्र और सर्वर का नाम जांचें."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Koneksi TLS gagal. Periksa sertifikat dan nama server."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "TLS 接続に失敗しました。証明書とサーバー名を確認してください。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "TLS कनेक्शन अयशस्वी झाले. प्रमाणपत्र आणि सर्व्हर नाव तपासा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "The TLS connection failed. Check certificate and server name."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A conexão TLS falhou. Verifique o certificado e o nome do servidor."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Соединение TLS не удалось. Проверьте сертификат и имя сервера."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "TLS-anslutningen misslyckades. Kontrollera certifikat och servernamn."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Muunganisho wa TLS umeshindikana. Angalia cheti na jina la seva."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "TLS కనెక్షన్ విఫలమైంది. సర్టిఫికేట్ మరియు సర్వర్ పేరును పరిశీలించండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "TLS bağlantısı başarısız oldu. Sertifikayı ve sunucu adını kontrol et."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "TLS کنکشن ناکام ہو گیا۔ سرٹیفکیٹ اور سرور کا نام چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Kết nối TLS đã thất bại. Kiểm tra chứng chỉ và tên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "TLS 连接失败。检查证书和服务器名称。"
          }
        }
      }
    },
    "Die Zugangsdaten sind ungültig.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "بيانات الوصول غير صالحة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "অ্যাক্সেস ডেটা অবৈধ৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The credentials are invalid."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Los datos de acceso no son válidos."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Les données d'accès ne sont pas valides."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Bayanan shiga ba daidai ba ne."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "एक्सेस डेटा अमान्य है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Data akses tidak valid."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "アクセスデータが不正です。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "प्रवेश माहिती अवैध आहे."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Login details are invalid."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Os dados de acesso são inválidos."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Данные доступа недействительны."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Autentiseringsuppgifterna är ogiltiga."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Vitambulisho si sahihi."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ప్రవేశ సమాచారం చెల్లుబాటు కాదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Giriş bilgileriniz geçersiz."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "رسائی کا ڈیٹا غلط ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Thông tin đăng nhập không hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "访问数据无效。"
          }
        }
      }
    },
    "Die erreichbaren Quellen melden keine Probleme. Mindestens ein Stand ist veraltet.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "المصادر المتاحة تشير إلى عدم وجود مشاكل. موقف واحد على الأقل قديم."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "উপলব্ধ সূত্র কোন সমস্যা রিপোর্ট. অন্তত একটি স্ট্যান্ড পুরানো."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The reachable sources report no problems. At least one source is outdated."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Las fuentes disponibles no informan de problemas. Al menos un stand está desactualizado."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Les sources disponibles ne signalent aucun problème. Au moins un stand est obsolète."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Tushen da ake iya samu baya bayar da rahoton matsala. Aƙalla ɗaya daga cikin matsayin ya tsufa."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "उपलब्ध स्रोत कोई समस्या नहीं बताते हैं। कम से कम एक स्टैंड पुराना हो चुका है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sumber yang tersedia melaporkan tidak ada masalah. Setidaknya satu stand sudah ketinggalan jaman."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "入手可能な情報源では問題は報告されていません。少なくとも 1 つのスタンドが期限切れです。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "उपलब्ध स्रोतांनी कोणतीही समस्या नोंदवलेली नाही. किमान एक स्टँड जुना आहे."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Available sources report no issues. At least one site is outdated."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "As fontes disponíveis não relatam problemas. Pelo menos um estande está desatualizado."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Доступные источники сообщают об отсутствии проблем. Как минимум один стенд устарел."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "De tillgängliga källorna rapporterar inga problem. Minst en version är föråldrad."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Vyanzo vinavyopatikana havijaripoti matatizo. Angalau mojawapo ni ya zamani."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "రచించదగిన సోర్సులు ఏ సమస్యను తెలియజేయలేదు. కనీసం ఒక స్థిరత పాతది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Erişilebilir kaynaklar herhangi bir sorun bildirmiyor. En az bir durum eski."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "دستیاب ذرائع نے کوئی مسئلہ نہیں بتایا۔ کم از کم ایک اسٹینڈ پرانا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Các nguồn có thể truy cập không báo cáo vấn đề. Ít nhất một cơ sở dữ liệu đã lỗi thời."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "可用来源报告没有问题。至少有一个摊位已经过时了。"
          }
        }
      }
    },
    "Die gespeicherten Quellen konnten nicht geladen werden: %@": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن تحميل المصادر المحفوظة: %@"
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "সংরক্ষিত উত্স লোড করা যাবে না: %@"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The saved sources could not be loaded: %@"
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "No se pudieron cargar las fuentes guardadas: %@"
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Les sources enregistrées n'ont pas pu être chargées : %@"
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya loda tushen da aka adana ba: %@"
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सहेजे गए स्रोत लोड नहीं किए जा सके: %@"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sumber yang disimpan tidak dapat dimuat: %@"
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "保存されたソースをロードできませんでした: %@"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
