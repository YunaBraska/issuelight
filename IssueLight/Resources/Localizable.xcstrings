    "Das CA-Zertifikat konnte nicht aus dem Schlüsselbund gelesen werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تعذرت قراءة شهادة CA من سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "কীচেন থেকে CA শংসাপত্র পড়া যায়নি।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The CA certificate could not be read from the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "No se pudo leer el certificado de CA desde el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat CA n'a pas pu être lu à partir du trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya karanta takardar shedar CA daga ma'ajiyar maɓalli ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "कीचेन से सीए प्रमाणपत्र पढ़ा नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat CA tidak dapat dibaca dari gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "CA 証明書をキーチェーンから読み取ることができませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "CA-प्रमाणपत्र कीचेनमधून वाचले जाऊ शकले नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "CA certificate can't read from keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado CA não pôde ser lido nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат CA не удалось прочитать из связки ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "CA-certifikatet kunde inte läsas från nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Hatuwezi kusoma cheti cha CA kutoka kwenye mfuko wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "CA-సర్టిఫికెట్ ను కీలుబంధం నుండి చదవలేకపోయాం."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "CA sertifikası anahtar zincirinden okunamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "کیچین سے CA سرٹیفکیٹ پڑھا نہیں جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể đọc chứng chỉ CA từ chìa khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法从钥匙串中读取 CA 证书。"
          }
        }
      }
    },
    "Das CA-Zertifikat konnte nicht importiert werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يمكن استيراد شهادة CA."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "CA শংসাপত্র আমদানি করা যায়নি৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The CA certificate could not be imported."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "No se pudo importar el certificado de CA."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat CA n'a pas pu être importé."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a iya shigo da takardar shaidar CA ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "CA प्रमाणपत्र आयात नहीं किया जा सका."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat CA tidak dapat diimpor."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "CA 証明書をインポートできませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "CA प्रमाणपत्र आयात करता आले नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "CA certificate can't import."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado CA não pôde ser importado."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат CA не удалось импортировать."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "CA-certifikatet kunde inte importeras."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Shaha ya CA haiwezi kuingizwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "CA సర్టిఫికేట్ ను దిగుమతి చేయడం సాధ్యంకాకుండా ఉంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "CA sertifikası içe aktarılamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "CA سرٹیفکیٹ درآمد نہیں کیا جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể nhập chứng chỉ CA."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法导入 CA 证书。"
          }
        }
      }
    },
    "Das CA-Zertifikat wurde importiert, aber ein zuvor ungenutztes Zertifikat konnte nicht entfernt werden.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تم استيراد شهادة CA، لكن تعذرت إزالة الشهادة غير المستخدمة سابقًا."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "CA শংসাপত্রটি আমদানি করা হয়েছে, কিন্তু একটি পূর্বে অব্যবহৃত শংসাপত্র সরানো যায়নি৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The CA certificate was imported, but a previously unused certificate could not be removed."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Se importó el certificado de CA, pero no se pudo eliminar un certificado no utilizado anteriormente."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat CA a été importé, mais un certificat précédemment inutilisé n'a pas pu être supprimé."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "An shigo da takardar shaidar CA, amma ba a iya cire takardar shaidar da bai taɓa amfani da shi ba a baya ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सीए प्रमाणपत्र आयात किया गया था, लेकिन पहले अप्रयुक्त प्रमाणपत्र को हटाया नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat CA telah diimpor, namun sertifikat yang sebelumnya tidak digunakan tidak dapat dihapus."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "CA 証明書はインポートされましたが、以前に使用されていなかった証明書を削除できませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "CA प्रमाणपत्र आयात केले गेले, परंतु पूर्वी न वापरलेले प्रमाणपत्र काढता आले नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "CA certificate imported, but unused certificate can't be removed."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado CA foi importado, mas não foi possível remover um certificado não utilizado anteriormente."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат ЦС был импортирован, но ранее неиспользованный сертификат удалить не удалось."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "CA-certifikatet har importerats, men ett tidigare oanvänt certifikat kunde inte tas bort."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Shaha ya CA imeingizwa, lakini shaha ambayo haijawahi kutumika haiwezi kuondolewa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "CA సర్టిఫికేట్ దిగుమతి చేయబడింది, కానీ ముందుగా ఉపయోగించని một సర్టిఫికేట్ తొలగించలేకపోయారు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "CA sertifikası içe aktarıldı, ancak daha önce kullanılmamış bir sertifika kaldırılamadı."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "CA سرٹیفکیٹ درآمد کیا گیا تھا، لیکن پہلے غیر استعمال شدہ سرٹیفکیٹ کو ہٹایا نہیں جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chứng chỉ CA đã được nhập, nhưng một chứng chỉ trước đây chưa sử dụng không thể bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "CA 证书已导入，但无法删除以前未使用的证书。"
          }
        }
      }
    },
    "Das Client-Zertifikat ist nicht mehr im Schlüsselbund verfügbar.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لم تعد شهادة العميل متوفرة في سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "ক্লায়েন্ট শংসাপত্রটি কীচেইনে আর উপলব্ধ নেই৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The client certificate is no longer available in the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El certificado del cliente ya no está disponible en el llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le certificat client n'est plus disponible dans le trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Takardar shaidar abokin ciniki ba ta nan a cikin ma'ajin makullai."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "क्लाइंट प्रमाणपत्र अब किचेन में उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Sertifikat klien tidak lagi tersedia di rantai kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "クライアント証明書はキーチェーンで使用できなくなりました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "क्लायंट प्रमाणपत्र आता कीचेनमध्ये उपलब्ध नाही."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Client certificate not available in keychain anymore."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado do cliente não está mais disponível nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат клиента больше не доступен в связке ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Klientcertifikatet är inte längre tillgängligt i nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Shaha ya Mteja haipatikani tena kwenye mkoba wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "క్లయింట్ సర్టిఫికేట్ ఇక కీచైన్‌లో అందుబాటులో లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "İstemci sertifikası artık anahtar zincirinde bulunmamaktadır."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "کلائنٹ کا سرٹیفکیٹ اب کیچین میں دستیاب نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chứng chỉ client không còn có sẵn trong chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "客户端证书在钥匙串中不再可用。"
          }
        }
      }
    },
