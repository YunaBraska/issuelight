            "value": "Pendaftaran ditolak."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "登録が拒否されました。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "नोंदणी नाकारली गेली."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Login was rejected."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O registro foi rejeitado."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "В регистрации было отказано."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Inloggningen nekades."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Uandishi wa jina umekataliwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "లాగిన్ ను తిరస్కరించబడింది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kayıt reddedildi."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "رجسٹریشن مسترد کر دی گئی۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Đăng nhập bị từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "注册被拒绝。"
          }
        }
      }
    },
    "Die Anmeldung wurde abgelehnt. Prüfe Zugangsdaten oder API-Benutzer.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تم رفض التسجيل. تحقق من بيانات الاعتماد أو مستخدم API."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "নিবন্ধন প্রত্যাখ্যান করা হয়. শংসাপত্র বা API ব্যবহারকারী চেক করুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The login was rejected. Check credentials or API user."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "El registro fue rechazado. Consultar credenciales o usuario API."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "L'enregistrement a été rejeté. Vérifiez les informations d'identification ou l'utilisateur API."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "An ƙi rajista. Duba bayanan shiga ko mai amfani API."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "पंजीकरण खारिज कर दिया गया. क्रेडेंशियल या API उपयोगकर्ता की जाँच करें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Pendaftaran ditolak. Periksa kredensial atau pengguna API."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "登録が拒否されました。資格情報または API ユーザーを確認してください。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "नोंदणी नाकारली गेली. प्रवेश डेटा किंवा API-युजर तपासा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Registration rejected. Check login details or API user."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O registro foi rejeitado. Verifique as credenciais ou usuário API."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "В регистрации было отказано. Проверьте учетные данные или пользователя API."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Inloggningen nekades. Kontrollera inloggningsuppgifter eller API-användare."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Uandishi wa jina umekataliwa. Angalia taarifa za ingia au mtumiaji API."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "లాగిన్ ను తిరస్కరించబడింది. యాక్సెస్ డేటా లేదా API-వినియోగదారును తనిఖీ చేయండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kayıt reddedildi. Giriş bilgilerini veya API-kullanıcıyı kontrol edin."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "رجسٹریشن مسترد کر دی گئی۔ اسناد چیک کریں یا API صارف۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Đăng nhập bị từ chối. Kiểm tra thông tin đăng nhập hoặc người dùng API."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "注册被拒绝。检查凭据或 API 用户。"
          }
        }
      }
    },
    "Die Konfiguration und das zugehörige Basic-Passwort werden von diesem Mac entfernt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "ستتم إزالة التكوين وكلمة المرور الأساسية المرتبطة به من جهاز Mac هذا."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "এই ম্যাক থেকে কনফিগারেশন এবং সংশ্লিষ্ট বেসিক পাসওয়ার্ড মুছে ফেলা হবে।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The configuration and the associated basic password will be removed from this Mac."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La configuración y la contraseña básica asociada se eliminarán de esta Mac."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La configuration et le mot de passe de base associé seront supprimés de ce Mac."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Za a cire tsarin da kalmar sirri ta asali daga wannan Mac."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "इस मैक से कॉन्फ़िगरेशन और संबंधित बेसिक पासवर्ड हटा दिया जाएगा।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Konfigurasi dan kata sandi Dasar terkait akan dihapus dari Mac ini."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "設定および関連する基本パスワードは、この Mac から削除されます。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "कॉन्फिगरेशन आणि संबंधित बेसिक पासवर्ड या मॅकवरून काढले जातील."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Configuration and associated basic password will be removed from this Mac."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A configuração e a senha básica associada serão removidas deste Mac."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Конфигурация и связанный с ней базовый пароль будут удалены с этого Mac."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Konfigurationen och det tillhörande grundlösenordet tas bort från denna Mac."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Usanidi na neno la siri la msingi linalohusiana vinatolewa kwenye Mac hii."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఈ Macs నుండి కాంఫిగరేషన్ మరియు సంబంధిత బేసిక్ పాస్వర్డ్ తొలగించబడుతుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Yapılandırma ve ilgili temel şifre bu Mac'ten kaldırılacak."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "اس میک سے کنفیگریشن اور متعلقہ بنیادی پاس ورڈ ہٹا دیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Cấu hình và mật khẩu cơ bản liên quan sẽ bị xóa khỏi Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "配置和关联的基本密码将从该 Mac 中删除。"
          }
        }
      }
    },
    "Die Konfiguration wird entfernt. Das Client-Zertifikat bleibt im macOS-Schlüsselbund.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "تتم إزالة التكوين. تظل شهادة العميل في سلسلة المفاتيح macOS."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "কনফিগারেশন সরানো হয়. ক্লায়েন্ট শংসাপত্রটি macOS কীচেইনে থাকে।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The configuration is being removed. The client certificate remains in the macOS keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Se elimina la configuración. El certificado de cliente permanece en el llavero macOS."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "La configuration est supprimée. Le certificat client reste dans le trousseau macOS."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Za a cire tsarin. Takaddar abokin ciniki za ta kasance a cikin maɓallin macOS."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "कॉन्फ़िगरेशन हटा दिया गया है. क्लाइंट प्रमाणपत्र macOS कीचेन में रहता है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Konfigurasi dihapus. Sertifikat klien tetap berada di gantungan kunci macOS."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "設定が削除されます。クライアント証明書は macOS キーチェーンに残ります。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "कॉन्फिगरेशन काढले जाईल. क्लायंट प्रमाणपत्र macOS-कळींच्या बंडलमध्ये राहील."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Configuration will be removed. Client certificate remains in the macOS keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "A configuração é removida. O certificado do cliente permanece nas chaves macOS."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Конфигурация удалена. Сертификат клиента остается в цепочке ключей macOS."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Konfigurationen tas bort. Klientcertifikatet förblir i macOS-nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Usanidi unachukuliwa. Cheti cha Mteja kinasalia katika mkusanyiko wa maneno ya siri wa macOS."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "కాంఫిగరేషన్ తొలగించబడుతుంది. క్లయింట్ సర్టిఫికెట్ macOS-కీచైన్ లో ఉంటుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Yapılandırma kaldırılıyor. İstemci sertifikası macOS anahtar zincirinde kalacak."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "ترتیب کو ہٹا دیا گیا ہے۔ کلائنٹ کا سرٹیفکیٹ macOS کیچین میں رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Cấu hình sẽ bị xóa. Chứng chỉ khách hàng vẫn còn trong chuỗi khóa macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "配置被删除。客户端证书保留在 macOS 钥匙串中。"
          }
        }
      }
    },
    "Die Quelle konnte nicht entfernt werden: %@": {
