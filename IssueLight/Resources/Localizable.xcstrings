          "stringUnit": { "state": "translated",
            "value": "Elija un archivo con exactamente un certificado de CA."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Choisissez un fichier avec exactement un certificat CA."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Zaɓi fayil ɗin da ke da takaddun shaida na CA guda ɗaya kawai."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "बिल्कुल एक CA प्रमाणपत्र वाली फ़ाइल चुनें."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Pilih file dengan tepat satu sertifikat CA."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
