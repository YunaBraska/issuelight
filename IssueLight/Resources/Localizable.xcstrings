            "value": "%lld Ba a samu sabunta tushe ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "%lld स्रोत अद्यतन नहीं किये जा सके।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "%lld Sumber tidak dapat diperbarui."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "%lld ソースを更新できませんでした。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "%lld स्रोत अद्यतनित करता आले नाहीत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "%lld sources could not be updated."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "%lld As fontes não puderam ser atualizadas."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "%lld Не удалось обновить исходники."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "%lld Källor kunde inte uppdateras."
          }
        },
        "sw": {
