    "Verwende nur eine vom ausgewählten Monitoring-Typ unterstützte Serveradresse.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "استخدم فقط عنوان خادم مدعومًا بنوع المراقبة المحدد."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "শুধুমাত্র নির্বাচিত মনিটরিং টাইপ দ্বারা সমর্থিত একটি সার্ভার ঠিকানা ব্যবহার করুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Use only a server address supported by the selected monitoring type."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Utilice únicamente una dirección de servidor compatible con el tipo de supervisión seleccionado."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Utilisez uniquement une adresse de serveur prise en charge par le type de surveillance sélectionné."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Yi amfani da adireshin uwar garken da kawai nau'in kulawa da aka zaɓa ke goyi bayan."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "केवल चयनित मॉनिटरिंग प्रकार द्वारा समर्थित सर्वर पते का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Hanya gunakan alamat server yang didukung oleh jenis pemantauan yang dipilih."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "選択した監視タイプでサポートされているサーバー アドレスのみを使用してください。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "फक्त निवडलेल्या मॉनिटरिंग प्रकाराद्वारे समर्थित सर्व्हर पत्ता वापरा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Use only server addresses supported by the selected monitoring type."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Use apenas um endereço de servidor compatível com o tipo de monitoramento selecionado."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Используйте только адрес сервера, поддерживаемый выбранным типом мониторинга."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Använd endast en serveradress som stöds av den valda övervakningstypen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Tumia tu anwani ya seva inayoungwa mkono na aina ya ufuatiliaji uliyochaguliwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఎంచుకున్న మానిటరింగ్ రకంగా మద్దతు ఇచ్చిన సర్వర్ అడ్రస్ మాత్రమే వినియోగించండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Yalnızca seçilen izleme türü tarafından desteklenen bir sunucu adresi kullanın."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "صرف ایک سرور ایڈریس استعمال کریں جس کی حمایت منتخب مانیٹرنگ کی قسم سے ہو۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chỉ sử dụng địa chỉ máy chủ được loại giám sát đã chọn hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "仅使用所选监控类型支持的服务器地址。"
          }
        }
      }
    },
