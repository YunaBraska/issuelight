    "Wähle ein Client-Zertifikat aus dem Schlüsselbund.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "اختر شهادة عميل من سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "কীচেন থেকে একটি ক্লায়েন্ট শংসাপত্র চয়ন করুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Select a client certificate from the keychain."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Elija un certificado de cliente del llavero."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Choisissez un certificat client dans le trousseau."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Zaɓi Takaddun Shaida na Abokin Ciniki daga Ma'ajin Mabuɗi."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "किचेन से क्लाइंट प्रमाणपत्र चुनें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Pilih sertifikat klien dari gantungan kunci."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "キーチェーンからクライアント証明書を選択します。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "कीचेनमधून क्लायंट प्रमाणपत्र निवडा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Select a client certificate from the keychain."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Escolha um certificado de cliente nas chaves."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Выберите сертификат клиента из цепочки для ключей."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Välj ett klientcertifikat från nyckelringen."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Chagua cheti cha mteja kutoka kwenye mfuko wa funguo."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "కీ చైన్ నుండి một క్లయింట్ సర్టిఫికేట్ ఎన్నుకోండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Anahtarlıkta bir istemci sertifikası seçin."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "کیچین سے کلائنٹ کا سرٹیفکیٹ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chọn một chứng chỉ khách hàng từ chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "从钥匙串中选择客户端证书。"
          }
        }
      }
    },
    "Wähle ein gültiges Serverzertifikat für den SHA-256-Pin aus.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "حدد شهادة خادم صالحة للرقم SHA-256."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 পিনের জন্য একটি বৈধ সার্ভার শংসাপত্র নির্বাচন করুন।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Select a valid server certificate for the SHA-256 PIN."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Seleccione un certificado de servidor válido para el pin SHA-256."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Sélectionnez un certificat de serveur valide pour la broche SHA-256."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Zaɓi ingantaccen Takaddun Shaida na Sabar don SHA-256-Pin."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 पिन के लिए एक वैध सर्वर प्रमाणपत्र चुनें।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Pilih sertifikat server yang valid untuk pin SHA-256."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 ピンの有効なサーバー証明書を選択します。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256-पिनसाठी वैध सर्व्हर प्रमाणपत्र निवडा."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Select a valid server certificate for the SHA-256 pin."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Selecione um certificado de servidor válido para o pino SHA-256."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Выберите действительный сертификат сервера для PIN-кода SHA-256."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Välj ett giltigt servercertifikat för SHA-256-pin."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Chagua cheti halali cha seva kwa namba ya SHA-256-Pin."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256-పిన్ కోసం ఒక చెల్లుబాటు అయ్యే సర్వర్ సర్టిఫికేట్ ను ఎన్నుకోండి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256-Pin için geçerli bir sunucu sertifikası seçin."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "SHA-256 پن کے لیے ایک درست سرور سرٹیفکیٹ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Chọn một chứng chỉ máy chủ hợp lệ cho mã PIN SHA-256."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "为 SHA-256 引脚选择有效的服务器证书。"
          }
        }
      }
    },
    "Wähle eine Datei mit genau einem CA-Zertifikat.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "اختر ملفًا يحتوي على شهادة CA واحدة بالضبط."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "ঠিক একটি CA শংসাপত্র সহ একটি ফাইল চয়ন করুন৷"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Select a file containing exactly one CA certificate."
          }
