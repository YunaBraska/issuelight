          "bn": {
            "stringUnit": { "state": "translated",
              "value": "এই কাজটি উৎস সমর্থন করে না।"
            }
          },
          "mr": {
            "stringUnit": { "state": "translated",
              "value": "ही कृती स्रोताला समर्थित नाही."
            }
          },
          "te": {
            "stringUnit": { "state": "translated",
              "value": "ఈ చర్యకు మూలం మద్దతు ఇవ్వదు."
            }
          },
          "ur": {
            "stringUnit": { "state": "translated",
              "value": "یہ کارروائی ماخذ میں معاون نہیں ہے۔"
            }
          },
          "sw": {
            "stringUnit": { "state": "translated",
              "value": "Chanzo hakitumii kitendo hiki."
            }
          },
          "ha": {
            "stringUnit": { "state": "translated",
              "value": "Tushen ba ya goyon bayan wannan aikin."
            }
          },
          "pcm": {
            "stringUnit": { "state": "translated",
              "value": "Di source no support dis action."
            }
          }
        }
      },
      "Die Aktion wurde von Icinga 2 bestätigt.": {
        "localizations": {
          "de": {
            "stringUnit": { "state": "translated",
              "value": "Die Aktion wurde von Icinga 2 bestätigt."
            }
          },
          "en": {
            "stringUnit": { "state": "translated",
              "value": "The action was confirmed by Icinga 2."
            }
          },
          "sv": {
            "stringUnit": { "state": "translated",
              "value": "Åtgärden bekräftades av Icinga 2."
            }
          },
          "es": {
            "stringUnit": { "state": "translated",
              "value": "Icinga 2 confirmó la acción."
            }
          },
          "fr": {
            "stringUnit": { "state": "translated",
              "value": "L’action a été confirmée par Icinga 2."
            }
          },
          "pt": {
            "stringUnit": { "state": "translated",
              "value": "A ação foi confirmada pelo Icinga 2."
            }
          },
          "ru": {
            "stringUnit": { "state": "translated",
              "value": "Действие подтверждено Icinga 2."
            }
          },
          "tr": {
            "stringUnit": { "state": "translated",
              "value": "Eylem Icinga 2 tarafından onaylandı."
            }
          },
          "id": {
            "stringUnit": { "state": "translated",
              "value": "Tindakan dikonfirmasi oleh Icinga 2."
            }
          },
          "vi": {
            "stringUnit": { "state": "translated",
              "value": "Tác vụ đã được Icinga 2 xác nhận."
            }
          },
          "zh-Hans": {
            "stringUnit": { "state": "translated",
              "value": "Icinga 2 已确认该操作。"
            }
          },
          "ja": {
            "stringUnit": { "state": "translated",
              "value": "操作は Icinga 2 によって確認されました。"
            }
          },
          "ar": {
            "stringUnit": { "state": "translated",
              "value": "أكد Icinga 2 الإجراء."
            }
          },
          "hi": {
            "stringUnit": { "state": "translated",
              "value": "कार्रवाई की पुष्टि Icinga 2 ने की।"
            }
          },
          "bn": {
            "stringUnit": { "state": "translated",
              "value": "কাজটি Icinga 2 নিশ্চিত করেছে।"
            }
          },
          "mr": {
            "stringUnit": { "state": "translated",
              "value": "कृतीला Icinga 2 ने पुष्टी दिली."
            }
          },
          "te": {
            "stringUnit": { "state": "translated",
              "value": "చర్యను Icinga 2 నిర్ధారించింది."
            }
          },
          "ur": {
            "stringUnit": { "state": "translated",
              "value": "کارروائی کی تصدیق Icinga 2 نے کی۔"
            }
          },
          "sw": {
            "stringUnit": { "state": "translated",
              "value": "Kitendo kimethibitishwa na Icinga 2."
            }
          },
          "ha": {
            "stringUnit": { "state": "translated",
              "value": "Icinga 2 ya tabbatar da aikin."
            }
          },
          "pcm": {
            "stringUnit": { "state": "translated",
              "value": "Icinga 2 don confirm di action."
            }
          }
        }
      },
      "Alerts multiply. Attention does not.\nIssueLight sorts the signal before it reaches you.\nA star helps. Coffee keeps the beacon lit.": {
        "localizations": {
          "de": {
            "stringUnit": { "state": "translated",
              "value": "Warnungen vermehren sich. Aufmerksamkeit nicht.\nIssueLight sortiert das Signal, bevor es dich erreicht.\nEin Stern hilft. Kaffee hält das Licht am Leuchten."
            }
          },
          "en": {
            "stringUnit": { "state": "translated",
              "value": "Alerts multiply. Attention does not.\nIssueLight sorts the signal before it reaches you.\nA star helps. Coffee keeps the beacon lit."
            }
          },
          "sv": {
            "stringUnit": { "state": "translated",
              "value": "Larm förökar sig. Uppmärksamhet gör det inte.\nIssueLight sorterar signalen innan den når dig.\nEn stjärna hjälper. Kaffe håller fyren tänd."
            }
          },
          "es": {
            "stringUnit": { "state": "translated",
              "value": "Las alertas se multiplican. La atención no.\nIssueLight separa la señal antes de que te llegue.\nUna estrella ayuda. El café mantiene encendida la baliza."
            }
          },
          "fr": {
            "stringUnit": { "state": "translated",
              "value": "Les alertes se multiplient. Pas l’attention.\nIssueLight trie le signal avant qu’il ne vous atteigne.\nUne étoile aide. Le café garde la balise allumée."
            }
          },
          "pt": {
            "stringUnit": { "state": "translated",
              "value": "Os alertas multiplicam-se. A atenção não.\nO IssueLight separa o sinal antes de ele chegar até si.\nUma estrela ajuda. O café mantém o farol aceso."
            }
          },
          "ru": {
            "stringUnit": { "state": "translated",
              "value": "Оповещения множатся. Внимание — нет.\nIssueLight отделяет сигнал до того, как он дойдёт до вас.\nЗвезда помогает. Кофе поддерживает маяк."
            }
          },
          "tr": {
            "stringUnit": { "state": "translated",
              "value": "Uyarılar çoğalır. Dikkat çoğalmaz.\nIssueLight sinyali size ulaşmadan ayıklar.\nBir yıldız yardımcı olur. Kahve ışığı açık tutar."
            }
          },
          "id": {
            "stringUnit": { "state": "translated",
              "value": "Peringatan bertambah. Perhatian tidak.\nIssueLight memilah sinyal sebelum sampai kepada Anda.\nBintang membantu. Kopi menjaga suar tetap menyala."
            }
          },
          "vi": {
            "stringUnit": { "state": "translated",
              "value": "Cảnh báo sinh sôi. Sự chú ý thì không.\nIssueLight lọc tín hiệu trước khi nó đến với bạn.\nMột ngôi sao sẽ hữu ích. Cà phê giữ đèn hiệu luôn sáng."
            }
          },
          "zh-Hans": {
            "stringUnit": { "state": "translated",
              "value": "告警会增多，注意力不会。\nIssueLight 在信号到达你之前先进行筛选。\n一个星标会有帮助。咖啡让信标长明。"
            }
          },
          "ja": {
            "stringUnit": { "state": "translated",
              "value": "アラートは増えます。注意力は増えません。\nIssueLight は届く前にシグナルを整理します。\nスターが励みになります。コーヒーが灯台を照らし続けます。"
            }
          },
          "ar": {
            "stringUnit": { "state": "translated",
              "value": "تتكاثر التنبيهات، أما الانتباه فلا.\nيرتب IssueLight الإشارة قبل أن تصل إليك.\nتساعد النجمة، وتبقي القهوة المنارة مضاءة."
            }
          },
          "hi": {
            "stringUnit": { "state": "translated",
              "value": "अलर्ट बढ़ते हैं, ध्यान नहीं।\nIssueLight संकेत को आप तक पहुँचने से पहले छाँटता है।\nएक सितारा मदद करता है। कॉफी बीकन को जलाए रखती है।"
            }
          },
          "bn": {
            "stringUnit": { "state": "translated",
              "value": "সতর্কতা বাড়ে, মনোযোগ বাড়ে না।\nIssueLight সংকেত আপনার কাছে পৌঁছানোর আগেই বাছাই করে।\nএকটি তারকা সাহায্য করে। কফি বাতি জ্বালিয়ে রাখে।"
            }
          },
          "mr": {
            "stringUnit": { "state": "translated",
              "value": "सूचना वाढतात, लक्ष नाही.\nIssueLight संकेत तुमच्यापर्यंत पोहोचण्यापूर्वी निवडतो.\nएक तारा मदत करतो. कॉफी दिवा पेटता ठेवते."
            }
          },
          "te": {
            "stringUnit": { "state": "translated",
              "value": "హెచ్చరికలు పెరుగుతాయి. శ్రద్ధ పెరగదు.\nIssueLight సంకేతాన్ని మీకు చేరే ముందే వడపోస్తుంది.\nఒక స్టార్ సహాయపడుతుంది. కాఫీ దీపాన్ని వెలిగిస్తుంది."
            }
          },
          "ur": {
            "stringUnit": { "state": "translated",
              "value": "انتباہات بڑھتے ہیں، توجہ نہیں۔\nIssueLight اشارہ آپ تک پہنچنے سے پہلے چھانٹتا ہے۔\nایک ستارہ مدد کرتا ہے۔ کافی روشنی جلائے رکھتی ہے۔"
            }
          },
          "sw": {
            "stringUnit": { "state": "translated",
              "value": "Tahadhari huongezeka. Umakini hauongezeki.\nIssueLight huchuja ishara kabla haijakufikia.\nNyota husaidia. Kahawa huweka mnara ukiwaka."
            }
          },
          "ha": {
            "stringUnit": { "state": "translated",
              "value": "Faɗakarwa na ƙaruwa. Hankali ba ya ƙaruwa.\nIssueLight yana tace siginar kafin ta isa gare ka.\nTauraro yana taimakawa. Kofi yana riƙe fitilar tana haske."
            }
          },
          "pcm": {
            "stringUnit": { "state": "translated",
              "value": "Alerts dey multiply. Attention no dey.\nIssueLight sort di signal before e reach you.\nOne star dey help. Coffee dey keep di beacon on."
            }
          }
        }
      },
      "Green is a temporary agreement between distributed systems.\nIssueLight watches the fine print.\nStar it if it saved a minute. Fuel it if it saved the night.": {
        "localizations": {
          "de": {
            "stringUnit": { "state": "translated",
              "value": "Grün ist eine vorübergehende Einigung verteilter Systeme.\nIssueLight liest das Kleingedruckte.\nEin Stern für die gesparte Minute. Kaffee für die gerettete Nacht."
            }
          },
          "en": {
            "stringUnit": { "state": "translated",
              "value": "Green is a temporary agreement between distributed systems.\nIssueLight watches the fine print.\nStar it if it saved a minute. Fuel it if it saved the night."
            }
          },
          "sv": {
            "stringUnit": { "state": "translated",
              "value": "Grönt är en tillfällig överenskommelse mellan distribuerade system.\nIssueLight läser det finstilta.\nGe en stjärna om det sparade en minut. Tanka om det räddade natten."
            }
          },
          "es": {
            "stringUnit": { "state": "translated",
              "value": "El verde es un acuerdo temporal entre sistemas distribuidos.\nIssueLight vigila la letra pequeña.\nDale una estrella si ahorró un minuto. Invita a un café si salvó la noche."
            }
          },
          "fr": {
            "stringUnit": { "state": "translated",
              "value": "Le vert est un accord temporaire entre systèmes distribués.\nIssueLight surveille les petits caractères.\nAjoutez une étoile si une minute a été gagnée. Offrez un café si la nuit a été sauvée."
            }
          },
          "pt": {
            "stringUnit": { "state": "translated",
              "value": "Verde é um acordo temporário entre sistemas distribuídos.\nO IssueLight observa as letras pequenas.\nDê uma estrela se poupou um minuto. Ofereça um café se salvou a noite."
            }
          },
          "ru": {
            "stringUnit": { "state": "translated",
              "value": "Зелёный статус — временное соглашение распределённых систем.\nIssueLight читает мелкий шрифт.\nПоставьте звезду, если сэкономили минуту. Угостите кофе, если спасли ночь."
            }
          },
          "tr": {
            "stringUnit": { "state": "translated",
              "value": "Yeşil, dağıtık sistemler arasındaki geçici bir anlaşmadır.\nIssueLight ayrıntıları izler.\nBir dakika kazandırdıysa yıldız verin. Geceyi kurtardıysa kahve ısmarlayın."
            }
          },
          "id": {
            "stringUnit": { "state": "translated",
              "value": "Hijau adalah kesepakatan sementara antarsistem terdistribusi.\nIssueLight memperhatikan rincian kecil.\nBeri bintang jika menghemat semenit. Traktir kopi jika menyelamatkan malam."
            }
          },
          "vi": {
            "stringUnit": { "state": "translated",
              "value": "Màu xanh là một thỏa thuận tạm thời giữa các hệ thống phân tán.\nIssueLight theo dõi cả những dòng chữ nhỏ.\nHãy tặng sao nếu tiết kiệm được một phút. Mời cà phê nếu cứu được cả đêm."
            }
          },
          "zh-Hans": {
            "stringUnit": { "state": "translated",
              "value": "绿色只是分布式系统之间的临时协议。\nIssueLight 关注细则。\n如果它节省了一分钟，请点个星标；如果它拯救了一整夜，请请杯咖啡。"
            }
          },
          "ja": {
            "stringUnit": { "state": "translated",
              "value": "緑は分散システム間の一時的な合意です。\nIssueLight は細部まで見守ります。\n1分を節約できたらスターを。夜を救えたらコーヒーを。"
            }
          },
          "ar": {
            "stringUnit": { "state": "translated",
              "value": "الأخضر اتفاق مؤقت بين الأنظمة الموزعة.\nيراقب IssueLight التفاصيل الدقيقة.\nضع نجمة إن وفر دقيقة، وقدّم قهوة إن أنقذ الليل."
            }
          },
          "hi": {
            "stringUnit": { "state": "translated",
              "value": "हरा रंग वितरित प्रणालियों के बीच अस्थायी समझौता है।\nIssueLight बारीक विवरण देखता है।\nएक मिनट बचा तो सितारा दें। रात बची तो कॉफी पिलाएँ।"
            }
          },
          "bn": {
            "stringUnit": { "state": "translated",
              "value": "সবুজ হলো বিতরণকৃত সিস্টেমগুলোর সাময়িক সমঝোতা।\nIssueLight সূক্ষ্ম বিষয়গুলো দেখে।\nএক মিনিট বাঁচালে তারকা দিন। রাত বাঁচালে কফি দিন।"
            }
          },
          "mr": {
            "stringUnit": { "state": "translated",
              "value": "हिरवा रंग हा वितरित प्रणालींमधला तात्पुरता करार आहे.\nIssueLight बारीक मजकूर पाहतो.\nएक मिनिट वाचले तर तारा द्या. रात्र वाचली तर कॉफी द्या."
            }
          },
          "te": {
            "stringUnit": { "state": "translated",
              "value": "ఆకుపచ్చ అనేది పంపిణీ వ్యవస్థల మధ్య తాత్కాలిక ఒప్పందం.\nIssueLight సూక్ష్మ వివరాలను గమనిస్తుంది.\nఒక నిమిషం ఆదా అయితే స్టార్ ఇవ్వండి. రాత్రిని కాపాడితే కాఫీ ఇవ్వండి."
            }
          },
          "ur": {
            "stringUnit": { "state": "translated",
              "value": "سبز رنگ تقسیم شدہ نظاموں کے درمیان عارضی معاہدہ ہے۔\nIssueLight باریک تفصیل دیکھتا ہے۔\nایک منٹ بچا تو ستارہ دیں۔ رات بچی تو کافی دیں۔"
            }
          },
          "sw": {
            "stringUnit": { "state": "translated",
              "value": "Kijani ni makubaliano ya muda kati ya mifumo iliyosambazwa.\nIssueLight huangalia maandishi madogo.\nToa nyota ikiokoa dakika. Nunua kahawa ikiokoa usiku."
            }
          },
          "ha": {
            "stringUnit": { "state": "translated",
              "value": "Kore yarjejeniya ce ta ɗan lokaci tsakanin tsarin da aka rarraba.\nIssueLight yana lura da ƙananan bayanai.\nBa tauraro idan ya ceci minti. Ba kofi idan ya ceci dare."
            }
          },
          "pcm": {
            "stringUnit": { "state": "translated",
              "value": "Green na temporary agreement between distributed systems.\nIssueLight dey watch di small details.\nGive star if e save one minute. Buy coffee if e save di night."
            }
          }
        }
      },
      "The quiet menu bar is not doing nothing.\nIt is waiting for evidence.\nStar the repository if that restraint feels useful.": {
        "localizations": {
          "de": {
            "stringUnit": { "state": "translated",
              "value": "Die ruhige Menüleiste ist nicht untätig.\nSie wartet auf Beweise.\nGib dem Repository einen Stern, wenn dir diese Zurückhaltung gefällt."
            }
          },
          "en": {
            "stringUnit": { "state": "translated",
              "value": "The quiet menu bar is not doing nothing.\nIt is waiting for evidence.\nStar the repository if that restraint feels useful."
            }
          },
          "sv": {
            "stringUnit": { "state": "translated",
              "value": "Den tysta menyraden gör inte ingenting.\nDen väntar på bevis.\nGe projektet en stjärna om den återhållsamheten känns användbar."
            }
          },
          "es": {
            "stringUnit": { "state": "translated",
              "value": "La barra de menús silenciosa no está sin hacer nada.\nEstá esperando pruebas.\nDale una estrella al repositorio si esa calma te resulta útil."
            }
          },
          "fr": {
            "stringUnit": { "state": "translated",
              "value": "La barre des menus silencieuse ne reste pas inactive.\nElle attend des preuves.\nAjoutez une étoile au dépôt si cette retenue vous est utile."
            }
          },
          "pt": {
            "stringUnit": { "state": "translated",
              "value": "A barra de menus silenciosa não está parada.\nEstá à espera de provas.\nDê uma estrela ao repositório se essa contenção lhe for útil."
            }
          },
          "ru": {
            "stringUnit": { "state": "translated",
              "value": "Тихая строка меню не бездействует.\nОна ждёт доказательств.\nПоставьте репозиторию звезду, если такая сдержанность полезна."
            }
          },
          "tr": {
            "stringUnit": { "state": "translated",
              "value": "Sessiz menü çubuğu boş durmuyor.\nKanıt bekliyor.\nBu ölçülülük işinize yarıyorsa depoya yıldız verin."
            }
          },
          "id": {
            "stringUnit": { "state": "translated",
              "value": "Bilah menu yang tenang bukan berarti diam saja.\nIa sedang menunggu bukti.\nBeri bintang pada repositori jika ketenangan itu berguna."
            }
          },
          "vi": {
            "stringUnit": { "state": "translated",
              "value": "Thanh menu yên lặng không có nghĩa là không làm gì.\nNó đang chờ bằng chứng.\nHãy tặng sao cho kho mã nếu sự kiềm chế đó hữu ích."
            }
          },
          "zh-Hans": {
            "stringUnit": { "state": "translated",
              "value": "安静的菜单栏并非无所事事。\n它在等待证据。\n如果这种克制对你有用，请为仓库点个星标。"
            }
          },
          "ja": {
            "stringUnit": { "state": "translated",
              "value": "静かなメニューバーは何もしていないわけではありません。\n証拠を待っています。\nその節度が役立つならリポジトリにスターを。"
            }
          },
          "ar": {
            "stringUnit": { "state": "translated",
              "value": "شريط القوائم الهادئ لا يقف بلا عمل.\nإنه ينتظر الدليل.\nضع نجمة للمستودع إن كان هذا الهدوء مفيدًا."
            }
          },
          "hi": {
            "stringUnit": { "state": "translated",
              "value": "शांत मेनू बार खाली नहीं बैठा है।\nवह प्रमाण की प्रतीक्षा कर रहा है।\nयह संयम उपयोगी लगे तो रिपॉज़िटरी को सितारा दें।"
            }
          },
          "bn": {
            "stringUnit": { "state": "translated",
              "value": "নীরব মেনু বার অলস নয়।\nএটি প্রমাণের অপেক্ষায় আছে।\nএই সংযম কাজে লাগলে রিপোজিটরিতে তারকা দিন।"
            }
          },
          "mr": {
            "stringUnit": { "state": "translated",
              "value": "शांत मेनू बार निष्क्रिय नाही.\nतो पुराव्याची वाट पाहतो.\nहा संयम उपयोगी वाटला तर रिपॉझिटरीला तारा द्या."
            }
          },
          "te": {
            "stringUnit": { "state": "translated",
              "value": "నిశ్శబ్దమైన మెనూ బార్ ఏమీ చేయకుండా లేదు.\nఅది ఆధారం కోసం ఎదురుచూస్తోంది.\nఆ సంయమనం ఉపయోగకరమైతే రిపోజిటరీకి స్టార్ ఇవ్వండి."
            }
          },
          "ur": {
            "stringUnit": { "state": "translated",
              "value": "خاموش مینو بار فارغ نہیں ہے۔\nوہ ثبوت کا انتظار کر رہا ہے۔\nیہ ضبط مفید لگے تو ذخیرے کو ستارہ دیں۔"
            }
          },
          "sw": {
            "stringUnit": { "state": "translated",
              "value": "Upau wa menyu tulivu haujakaa bila kazi.\nUnasubiri ushahidi.\nToa nyota kwa hazina ikiwa utulivu huo unafaa."
            }
          },
          "ha": {
            "stringUnit": { "state": "translated",
              "value": "Sandar menu mai shiru ba ta zauna banza ba.\nTana jiran hujja.\nBa ma'ajiyar tauraro idan wannan natsuwa tana da amfani."
            }
          },
          "pcm": {
            "stringUnit": { "state": "translated",
              "value": "Di quiet menu bar no dey idle.\nE dey wait for evidence.\nGive di repository star if dat restraint useful."
            }
          }
        }
      },
      "Monitoring should interrupt you only when it has something useful to say.\nIssueLight keeps the noise down and the problems visible.\nCoffee is optional. Reliable alerts are not.": {
        "localizations": {
          "de": {
            "stringUnit": { "state": "translated",
              "value": "Monitoring sollte dich nur unterbrechen, wenn es etwas Nützliches zu sagen hat.\nIssueLight reduziert den Lärm und hält Probleme sichtbar.\nKaffee ist optional. Verlässliche Warnungen nicht."
            }
          },
          "en": {
            "stringUnit": { "state": "translated",
              "value": "Monitoring should interrupt you only when it has something useful to say.\nIssueLight keeps the noise down and the problems visible.\nCoffee is optional. Reliable alerts are not."
            }
          },
          "sv": {
            "stringUnit": { "state": "translated",
              "value": "Övervakning ska bara avbryta dig när den har något användbart att säga.\nIssueLight dämpar bruset och håller problemen synliga.\nKaffe är valfritt. Pålitliga larm är det inte."
            }
          },
          "es": {
            "stringUnit": { "state": "translated",
              "value": "La monitorización solo debería interrumpirte cuando tenga algo útil que decir.\nIssueLight reduce el ruido y mantiene visibles los problemas.\nEl café es opcional. Las alertas fiables no."
            }
          },
          "fr": {
            "stringUnit": { "state": "translated",
              "value": "La supervision ne devrait vous interrompre que lorsqu’elle a quelque chose d’utile à dire.\nIssueLight réduit le bruit et garde les problèmes visibles.\nLe café est facultatif. Les alertes fiables ne le sont pas."
            }
          },
          "pt": {
            "stringUnit": { "state": "translated",
              "value": "A monitorização só deve interrompê-lo quando tiver algo útil para dizer.\nO IssueLight reduz o ruído e mantém os problemas visíveis.\nO café é opcional. Alertas fiáveis não."
            }
          },
          "ru": {
            "stringUnit": { "state": "translated",
              "value": "Мониторинг должен прерывать вас, только когда ему есть что сказать.\nIssueLight снижает шум и оставляет проблемы на виду.\nКофе необязателен. Надёжные оповещения — нет."
            }
          },
          "tr": {
            "stringUnit": { "state": "translated",
              "value": "İzleme yalnızca söyleyecek yararlı bir şeyi olduğunda sizi bölmeli.\nIssueLight gürültüyü azaltır ve sorunları görünür tutar.\nKahve isteğe bağlıdır. Güvenilir uyarılar değildir."
            }
          },
          "id": {
            "stringUnit": { "state": "translated",
              "value": "Pemantauan seharusnya hanya menyela saat ada hal berguna untuk disampaikan.\nIssueLight meredam kebisingan dan menjaga masalah tetap terlihat.\nKopi itu opsional. Peringatan andal tidak."
            }
          },
          "vi": {
            "stringUnit": { "state": "translated",
              "value": "Giám sát chỉ nên ngắt lời bạn khi có điều hữu ích cần nói.\nIssueLight giảm nhiễu và giữ sự cố trong tầm mắt.\nCà phê là tùy chọn. Cảnh báo đáng tin cậy thì không."
            }
          },
          "zh-Hans": {
            "stringUnit": { "state": "translated",
              "value": "监控只应在有用时打扰你。\nIssueLight 降低噪音并让问题保持可见。\n咖啡可选，可靠告警不可少。"
            }
          },
          "ja": {
            "stringUnit": { "state": "translated",
              "value": "監視は伝えるべき有用なことがある時だけ割り込むべきです。\nIssueLight はノイズを抑え、問題を見える状態に保ちます。\nコーヒーは任意です。信頼できるアラートは必須です。"
            }
          },
          "ar": {
            "stringUnit": { "state": "translated",
              "value": "ينبغي للمراقبة أن تقاطعك فقط عندما يكون لديها ما يفيد.\nيخفض IssueLight الضوضاء ويبقي المشكلات ظاهرة.\nالقهوة اختيارية، أما التنبيهات الموثوقة فلا."
            }
          },
          "hi": {
            "stringUnit": { "state": "translated",
              "value": "निगरानी को आपको तभी रोकना चाहिए जब उसके पास उपयोगी बात हो।\nIssueLight शोर घटाता है और समस्याएँ दिखाता रहता है।\nकॉफी वैकल्पिक है। भरोसेमंद अलर्ट नहीं।"
            }
          },
          "bn": {
            "stringUnit": { "state": "translated",
              "value": "পর্যবেক্ষণ কেবল দরকারি কিছু বলার থাকলেই আপনাকে থামাবে।\nIssueLight কোলাহল কমায় এবং সমস্যাগুলো দৃশ্যমান রাখে।\nকফি ঐচ্ছিক। নির্ভরযোগ্য সতর্কতা নয়।"
            }
          },
          "mr": {
            "stringUnit": { "state": "translated",
              "value": "उपयुक्त काही सांगायचे असेल तेव्हाच निरीक्षणाने व्यत्यय आणावा.\nIssueLight गोंगाट कमी करतो आणि समस्या दिसत ठेवतो.\nकॉफी ऐच्छिक आहे. विश्वसनीय सूचना नाहीत."
            }
          },
          "te": {
            "stringUnit": { "state": "translated",
              "value": "ఉపయోగకరమైన విషయం ఉన్నప్పుడే పర్యవేక్షణ మిమ్మల్ని అంతరాయం చేయాలి.\nIssueLight శబ్దాన్ని తగ్గించి సమస్యలను కనిపించేలా ఉంచుతుంది.\nకాఫీ ఐచ్ఛికం. నమ్మదగిన హెచ్చరికలు కాదు."
            }
          },
          "ur": {
            "stringUnit": { "state": "translated",
              "value": "نگرانی کو صرف تب مداخلت کرنی چاہیے جب کہنے کو مفید بات ہو۔\nIssueLight شور کم کرتا اور مسائل نمایاں رکھتا ہے۔\nکافی اختیاری ہے۔ قابل اعتماد انتباہات نہیں۔"
            }
          },
          "sw": {
            "stringUnit": { "state": "translated",
              "value": "Ufuatiliaji unapaswa kukukatiza tu ukiwa na jambo muhimu la kusema.\nIssueLight hupunguza kelele na kuweka matatizo wazi.\nKahawa ni hiari. Tahadhari za kuaminika si hiari."
            }
          },
          "ha": {
            "stringUnit": { "state": "translated",
              "value": "Sa ido ya katse ka ne kawai idan yana da abu mai amfani da zai faɗa.\nIssueLight yana rage hayaniya kuma yana nuna matsaloli.\nKofi zaɓi ne. Faɗakarwa masu inganci ba zaɓi ba ne."
            }
          },
          "pcm": {
            "stringUnit": { "state": "translated",
              "value": "Monitoring suppose disturb you only when e get useful thing to talk.\nIssueLight reduce di noise and keep problems visible.\nCoffee optional. Reliable alerts no be optional."
            }
          }
        }
      },
