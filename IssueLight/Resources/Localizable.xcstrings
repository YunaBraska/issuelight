        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Server certificate can't read."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "O certificado do servidor não pôde ser lido."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Сертификат сервера не удалось прочитать."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Servercertifikatet kunde inte läsas."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Cheti cha seva hakiwezi kusomwa."
          }
        },
        "te": {
