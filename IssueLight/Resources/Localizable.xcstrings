    "IssueLight folgt der App-Sprache aus den macOS-Systemeinstellungen.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight يتبع لغة التطبيق من إعدادات النظام macOS."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight macOS সিস্টেম সেটিংস থেকে অ্যাপের ভাষা অনুসরণ করে।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight follows the app language from the macOS system settings."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight sigue el idioma de la aplicación desde la configuración del sistema macOS."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight suit la langue de l'application des paramètres système macOS."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight yana bin harshen manhaja daga saitunan tsarin macOS."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight, macOS सिस्टम सेटिंग्स से ऐप भाषा का अनुसरण करता है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight mengikuti bahasa aplikasi dari pengaturan sistem macOS."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight は、システム設定 macOS のアプリ言語に従います。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight अॅप भाषा macOS-सिस्टम सेटिंग्जपासून अनुसरते."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight folgt der App-Sprache aus den macOS-Systemeinstellungen."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight segue o idioma do aplicativo nas configurações do sistema macOS."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight соответствует языку приложения из системных настроек macOS."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight följer appens språk från macOS-systeminställningarna."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight inafuata lugha ya programu kutoka mipangilio ya mfumo wa macOS."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight macOS-సిస్టమ్ సెట్టింగ్లలోని యాప్ భాషను అనుసరిస్తుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight, App dilini macOS-sistem ayarlarından izler."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight macOS سسٹم کی ترتیبات سے ایپ کی زبان کی پیروی کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight tuân theo ngôn ngữ ứng dụng từ cài đặt hệ thống macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "IssueLight 遵循 macOS 系统设置中的应用程序语言。"
          }
        }
      }
    },
    "IssueLight fragt Hosts und Services bei der Quelle ab.": {
