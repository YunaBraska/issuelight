        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Cette option de certificat n'est pas encore prise en charge dans cette version."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Wannan zaɓin takaddun shaida ba a tallafawa shi a wannan sigar ba tukuna."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "यह प्रमाणपत्र विकल्प अभी तक इस संस्करण में समर्थित नहीं है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Opsi sertifikat ini belum didukung dalam versi ini."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "この証明書オプションは、このバージョンではまだサポートされていません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "हा प्रमाणपत्र पर्याय या संस्करणाद्वारे अद्याप समर्थित नाही."
          }
        },
        "pcm": {
