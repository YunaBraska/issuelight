    "Ungespeicherte Änderungen verwerfen?": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "هل تريد تجاهل التغييرات غير المحفوظة؟"
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "অসংরক্ষিত পরিবর্তনগুলি বাতিল করবেন?"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Discard unsaved changes?"
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "¿Descartar los cambios no guardados?"
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Supprimer les modifications non enregistrées ?"
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "A'a, kin yi canje-canje da ba a adana ba?"
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "सहेजे न गए परिवर्तन त्यागें?"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Buang perubahan yang belum disimpan?"
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "保存されていない変更を破棄しますか?"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "जतन न केलेले बदल रद्द करायचे?"
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Discard unsaved changes?"
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Descartar alterações não salvas?"
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Отменить несохраненные изменения?"
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Kasta osparade ändringar?"
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Toka mabadiliko yasiyo hifadhiwa?"
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "సేవ్ చేయని మార్పులను రద్దు చేయాలా?"
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Kaydedilmemiş değişiklikler iptal edilsin mi?"
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "غیر محفوظ شدہ تبدیلیاں رد کریں؟"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Bỏ những thay đổi chưa lưu?"
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "放弃未保存的更改？"
          }
        }
      }
    },
    "Unsicher. Identität und Serverdaten können abgefangen oder verändert werden. Diese Ausnahme gilt nur für diese Quelle.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "غير متأكد. يمكن اعتراض بيانات الهوية والخادم أو تغييرها. ينطبق هذا الاستثناء فقط على هذا المصدر."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "অনিশ্চিত। পরিচয় এবং সার্ভার ডেটা আটকানো বা পরিবর্তন করা যেতে পারে। এই ব্যতিক্রম শুধুমাত্র এই উত্স প্রযোজ্য."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "Unsecure. Identity and server data may be intercepted or modified. This exception applies only to this source."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Incierto. Los datos de identidad y del servidor pueden ser interceptados o alterados. Esta excepción sólo se aplica a esta fuente."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Incertain. Les données d'identité et de serveur peuvent être interceptées ou modifiées. Cette exception s'applique uniquement à cette source."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba tabbas. Ana iya sace ko canza bayanan asalin mutum da na uwar garke. Wannan banbanci yana aiki ne kawai ga wannan asalin."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "अनिश्चित. पहचान और सर्वर डेटा को रोका या बदला जा सकता है। यह अपवाद केवल इस स्रोत पर लागू होता है."
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "Tidak pasti. Identitas dan data server dapat disadap atau diubah. Pengecualian ini hanya berlaku untuk sumber ini."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "不確実。 ID とサーバーのデータが傍受または改ざんされる可能性があります。この例外は、このソースにのみ適用されます。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "असुरक्षित. ओळख आणि सर्व्हर डेटा इंटरसेप्ट किंवा बदलला जाऊ शकतो. हा अपवाद फक्त या स्रोतासाठी लागू आहे."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "Untrusted. Identity and server data can be intercepted or modified. This exception applies only to this source."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Incerto. Os dados de identidade e do servidor podem ser interceptados ou alterados. Esta exceção aplica-se apenas a esta fonte."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Неуверенно. Идентификационные данные и данные сервера могут быть перехвачены или изменены. Это исключение применимо только к этому источнику."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Osäkert. Identitet och serverdata kan avlyssnas eller ändras. Detta undantag gäller endast för denna källa."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Hauko salama. Utambulisho na data za seva zinaweza kushambuliwa au kubadilishwa. Toa hili ni kwa chanzo hiki tu."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "అసురక్షితం. గుర్తింపు మరియు సర్వర్ డేటా పడగొట్టబడవచ్చు లేదా మార్చబడవచ్చు. ఈ మించిపోయిన స్థితి కేవలం ఈ మూలానికి మాత్రమే వర్తిస్తుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Güvenli değil. Kimlik ve sunucu verileri yakalanabilir veya değiştirilebilir. Bu istisna yalnızca bu kaynak için geçerlidir."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "غیر یقینی شناخت اور سرور کے ڈیٹا کو روکا یا تبدیل کیا جا سکتا ہے۔ یہ استثناء صرف اس ماخذ پر لاگو ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không an toàn. Danh tính và dữ liệu máy chủ có thể bị chặn hoặc thay đổi. Ngoại lệ này chỉ áp dụng cho nguồn này."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "不确定。身份和服务器数据可能被拦截或更改。此例外仅适用于该来源。"
          }
        }
      }
    },
