    "Die API-Rechte reichen nicht zum Lesen des Status.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "حقوق API ليست كافية لقراءة الحالة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "স্ট্যাটাস পড়ার জন্য API অধিকার যথেষ্ট নয়।"
