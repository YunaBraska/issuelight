          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Không thể đọc chứng chỉ client từ chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "无法从钥匙串中读取客户端证书。"
          }
        }
      }
    },
    "Das Importpasswort wird nicht gespeichert.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "لا يتم حفظ كلمة مرور الاستيراد."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "আমদানি পাসওয়ার্ড সংরক্ষণ করা হয় না."
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "The import password is not saved."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "La contraseña de importación no se guarda."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le mot de passe d'importation n'est pas enregistré."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "Ba a adana kalmar wucewa don shigo da bayanai ba."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "आयात पासवर्ड सहेजा नहीं गया है."
