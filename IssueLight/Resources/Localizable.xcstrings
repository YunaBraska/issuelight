    "%@ Ein von IssueLight importiertes CA-Zertifikat wird nur entfernt, wenn keine andere Quelle es verwendet. Vorhandene fremde Zertifikate bleiben unberührt.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "%@ لن تتم إزالة شهادة CA المستوردة من IssueLight إلا في حالة عدم استخدام أي مصدر آخر لها. تظل شهادات الطرف الثالث الموجودة غير متأثرة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight থেকে আমদানি করা একটি CA শংসাপত্র শুধুমাত্র অন্য কোন উৎস ব্যবহার না করলেই সরানো হবে। বিদ্যমান তৃতীয় পক্ষের শংসাপত্রগুলি প্রভাবিত হয় না।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "%@ A CA certificate imported from IssueLight is only removed if no other source is using it. Existing foreign certificates remain unaffected."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "%@ Un certificado de CA importado de IssueLight solo se eliminará si ninguna otra fuente lo utiliza. Los certificados de terceros existentes no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "%@ Un certificat CA importé de IssueLight ne sera supprimé que si aucune autre source ne l'utilise. Les certificats tiers existants ne sont pas affectés."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "%@ Takaddar CA da aka shigo da ita daga IssueLight za a cire ta ne kawai idan babu wata hanya ta daban da ke amfani da ita. Takaddun shaidar na waje da ke akwai ba sa tabuka."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight से आयातित सीए प्रमाणपत्र केवल तभी हटाया जाएगा जब कोई अन्य स्रोत इसका उपयोग नहीं कर रहा हो। मौजूदा तृतीय-पक्ष प्रमाणपत्र अप्रभावित रहेंगे।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "%@ Sertifikat CA yang diimpor dari IssueLight hanya akan dihapus jika tidak ada sumber lain yang menggunakannya. Sertifikat pihak ketiga yang ada tetap tidak terpengaruh."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight からインポートされた CA 証明書は、他のソースが使用していない場合にのみ削除されます。既存のサードパーティ証明書は影響を受けません。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight कडून आयात केलेले CA प्रमाणपत्र फक्त तेव्हा काढले जाईल जेव्हा अन्य कोणताही स्रोत त्याचा वापर करत नाही. विद्यमान परकीय प्रमाणपत्रे अवरोधित राहतील."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "%@ Ein von IssueLight importiertes CA-Zertifikat wird nur entfernt, wenn keine andere Quelle es verwendet. Vorhandene fremde Zertifikate bleiben unberührt."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "%@ Um certificado CA importado de IssueLight só será removido se nenhuma outra fonte o utilizar. Os certificados de terceiros existentes não serão afetados."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "%@ Сертификат CA, импортированный из IssueLight, будет удален только в том случае, если его не использует никакой другой источник. Существующие сторонние сертификаты остаются без изменений."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "%@ Ett CA-certifikat importerat från IssueLight tas bara bort om ingen annan källa använder det. Befintliga externa certifikat förblir opåverkade."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "%@ Cheti cha CA kilichoingizwa na IssueLight kitaondolewa tu ikiwa hakuna chanzo kingine kinakitumia. Vyeti vya kigeni vilivyopo havitahusishwa."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight నుండి దిగుమతి చేయబడ్డ CA-సర్టిఫికేట్, మరే ఇతర మూలం ఉపయోగించకపోతే మాత్రమే తొలగించబడుతుంది. ఉన్న ఇతరరాజ్య సర్టిఫికేట్‌లు మినహాయిస్తాయి."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight tarafından içe aktarılan bir CA sertifikası, başka herhangi bir kaynak tarafından kullanılmadığı sürece yalnızca kaldırılır. Mevcut yabancı sertifikalar etkilenmez."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "%@ IssueLight سے درآمد کردہ CA سرٹیفکیٹ صرف اس صورت میں ہٹایا جائے گا جب کوئی دوسرا ذریعہ اسے استعمال نہ کر رہا ہو۔ موجودہ فریق ثالث کے سرٹیفیکیٹس غیر متاثر ہیں۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "%@ Một chứng chỉ CA được nhập từ IssueLight chỉ bị xóa khi không có nguồn nào khác sử dụng nó. Các chứng chỉ của bên thứ ba hiện có vẫn không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "%@ 仅当没有其他来源使用从 IssueLight 导入的 CA 证书时，才会删除该证书。现有的第三方证书不受影响。"
          }
        }
      }
    },
    "%@ ist erreichbar. Host- und Servicezugriff funktionieren.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "يمكن الوصول إلى %@. يعمل الوصول إلى المضيف والخدمة."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "%@ নম্বরে যোগাযোগ করা যাবে। হোস্ট এবং পরিষেবা অ্যাক্সেস কাজ করে।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "%@ is reachable. Host and service access are working."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "Se puede contactar al %@. El acceso al host y al servicio funciona."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "Le %@ peut être contacté. L’accès à l’hôte et au service fonctionne."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "%@ na iya samun dama. Samun damar mai masauki da sabis suna aiki."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "%@ पर संपर्क किया जा सकता है। मेज़बान और सेवा पहुँच कार्य।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "%@ dapat dihubungi. Akses host dan layanan berfungsi."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "%@ にアクセスできます。ホストとサービスへのアクセスが機能します。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "%@ पोहोचण्यायोग्य आहे. होस्ट आणि सेवा प्रवेश कार्यरत आहेत."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "%@ is reachable. Host- and Servicezugriff funktionieren."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "%@ pode ser contactado. O acesso ao host e ao serviço funciona."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "%@ можно связаться. Доступ к хосту и сервисам работает."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "%@ är tillgänglig. Host- och serviceåtkomst fungerar."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "%@ inapatikana. Ufikiaji wa mwenyeji na huduma unafanya kazi."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "%@ అందుబాటులో ఉంది. హోస్ట్ మరియు సర్వీస్ యాక్సెస్ పనిచేస్తోంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "%@ erişilebilir. Host ve servis erişimi çalışıyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "%@ پر رابطہ کیا جا سکتا ہے۔ میزبان اور خدمت تک رسائی کام کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "%@ có thể truy cập được. Truy cập máy chủ và dịch vụ hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "可以拨打%@。主机和服务访问正常。"
          }
        }
      }
    },
