    "„%@“ wird nur für diese Quellenkonfiguration als CA verwendet.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "يتم استخدام \"%@\" كـ CA لتكوين المصدر هذا فقط."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" শুধুমাত্র এই উৎস কনফিগারেশনের জন্য CA হিসাবে ব্যবহৃত হয়।"
          }
        },
        "en": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" is used as CA only for this source configuration."
          }
        },
        "es": {
          "stringUnit": { "state": "translated",
            "value": "“%@” se utiliza como CA solo para esta configuración de origen."
          }
        },
        "fr": {
          "stringUnit": { "state": "translated",
            "value": "« %@ » est utilisé comme autorité de certification pour cette configuration source uniquement."
          }
        },
        "ha": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" ana amfani da shi ne kawai a wannan tsarin tushe azaman CA."
          }
        },
        "hi": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" का उपयोग केवल इस स्रोत कॉन्फ़िगरेशन के लिए सीए के रूप में किया जाता है।"
          }
        },
        "id": {
          "stringUnit": { "state": "translated",
            "value": "“%@” digunakan sebagai CA untuk konfigurasi sumber ini saja."
          }
        },
        "ja": {
          "stringUnit": { "state": "translated",
            "value": "「%@」は、このソース構成のみの CA として使用されます。"
          }
        },
        "mr": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" फक्त या स्रोत कॉन्फिगरेशनसाठी CA म्हणून वापरले जाते."
          }
        },
        "pcm": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" is only used as CA for this source configuration."
          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "“%@” é usado como CA apenas para esta configuração de origem."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "«%@» используется в качестве центра сертификации только для этой исходной конфигурации."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" används endast som CA för denna källkonfiguration."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" inatumiwa kama CA kwa usanidi huu wa chanzo pekee."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" ఈ మూలసంఖ్యా కాన్ఫిగరేషన్ కోసం మాత్రమే CAగా ఉపయోగించబడుతుంది."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" yalnızca bu kaynak yapılandırması için CA olarak kullanılacak."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" صرف اس سورس کنفیگریشن کے لیے بطور CA استعمال ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "\"%@\" chỉ được sử dụng làm CA cho cấu hình nguồn này."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "“%@”仅用作此源配置的 CA。"
          }
        }
      }
