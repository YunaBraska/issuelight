    "Füge deine erste Monitoring-Quelle hinzu.": {
      "localizations": {
        "ar": {
          "stringUnit": { "state": "translated",
            "value": "أضف مصدر المراقبة الأول الخاص بك."
          }
        },
        "bn": {
          "stringUnit": { "state": "translated",
            "value": "আপনার প্রথম পর্যবেক্ষণ উৎস যোগ করুন."
