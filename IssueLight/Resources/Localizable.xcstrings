          }
        },
        "pt": {
          "stringUnit": { "state": "translated",
            "value": "Esta opção de certificado ainda não é suportada nesta versão."
          }
        },
        "ru": {
          "stringUnit": { "state": "translated",
            "value": "Этот вариант сертификата еще не поддерживается в этой версии."
          }
        },
        "sv": {
          "stringUnit": { "state": "translated",
            "value": "Detta certifikatalternativ stöds inte av denna version än."
          }
        },
        "sw": {
          "stringUnit": { "state": "translated",
            "value": "Chaguo hili la cheti bado halina msaada katika toleo hili."
          }
        },
        "te": {
          "stringUnit": { "state": "translated",
            "value": "ఈ సర్టిఫికెట్ ఎంపిక ఈ వెర్షన్ నుండి ఇంకా మద్దతు ఇవ్వబడడం లేదు."
          }
        },
        "tr": {
          "stringUnit": { "state": "translated",
            "value": "Bu sertifika seçeneği bu sürüm tarafından henüz desteklenmiyor."
          }
        },
        "ur": {
          "stringUnit": { "state": "translated",
            "value": "سرٹیفکیٹ کا یہ اختیار ابھی تک اس ورژن میں تعاون یافتہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": { "state": "translated",
            "value": "Tùy chọn chứng chỉ này chưa được phiên bản này hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated",
            "value": "此版本尚不支持此证书选项。"
          }
        }
      }
    },
